<Window x:Class="Scoreboard.Desktop.LauncherWindow" Icon="app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScorePlus" Width="700" Height="580" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#050607" Foreground="#F4F7FB"
        FontFamily="Segoe UI" ShowInTaskbar="True">
  <Window.Resources>
    <Style x:Key="LaunchPrimary" TargetType="Button">
      <Setter Property="Width" Value="236"/>
      <Setter Property="Height" Value="70"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="0,0,14,0"/>
      <Setter Property="Background" Value="#0B6B50"/>
      <Setter Property="BorderBrush" Value="#14A67C"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="LaunchSecondary" TargetType="Button" BasedOn="{StaticResource LaunchPrimary}">
      <Setter Property="Background" Value="#161C24"/>
      <Setter Property="BorderBrush" Value="#2E3B4A"/>
      <Setter Property="Margin" Value="0"/>
    </Style>
    <Style x:Key="LoadButton" TargetType="Button">
      <Setter Property="Padding" Value="18,9"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Background" Value="#161C24"/>
      <Setter Property="BorderBrush" Value="#2E3B4A"/>
      <Setter Property="Foreground" Value="#D6DCE5"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!-- The autosave card shares its row with two lines of text, so its buttons stay compact. -->
    <Style x:Key="AutosaveButton" TargetType="Button" BasedOn="{StaticResource LoadButton}">
      <Setter Property="Padding" Value="11,5"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="MinHeight" Value="28"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="72"/>
    </Grid.ColumnDefinitions>

    <DockPanel Grid.Column="0" Margin="38,30,28,26">
      <StackPanel DockPanel.Dock="Top">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <!-- The transparent brand mark sits on its own dark chip so it reads on any wallpaper. -->
          <Border Background="#0E1218" CornerRadius="11" Padding="10,6" Margin="0,0,14,0">
            <Image Source="Assets/logo.png" Height="56" Stretch="Uniform" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/>
          </Border>
          <TextBlock Text="SCOREPLUS" FontSize="40" FontWeight="Bold" Foreground="#F4F7FB"/>
        </StackPanel>
        <TextBlock Text="Powerful, dependable scorekeeping — every score, clock and stat under one roof." Foreground="#93A0B2" FontSize="13" Margin="2,8,0,0"/>
        <TextBlock Text="Start a fresh game, open a saved one, or pick up an autosave." Foreground="#5C6B7E" FontSize="12" Margin="2,3,0,0"/>

        <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
          <Button x:Name="NewGameButton" Style="{StaticResource LaunchPrimary}" Content="New Game" Click="NewGame_Click" IsDefault="True"/>
          <Button x:Name="OpenGameButton" Style="{StaticResource LaunchSecondary}" Content="Open Game" Click="OpenGame_Click"/>
        </StackPanel>
      </StackPanel>

      <Border DockPanel.Dock="Bottom" Background="#0B0F14" BorderBrush="#151B23" BorderThickness="1"
              CornerRadius="9" Padding="12,10" Margin="0,18,0,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
            <Button x:Name="ClearAutosavesButton" Style="{StaticResource AutosaveButton}" Content="Delete all"
                    Click="ClearAutosaves_Click" Margin="0,0,6,0"
                    ToolTip="Remove every recoverable point from this computer. Saved .spg games are not touched."/>
            <Button x:Name="LoadAutosaveButton" Style="{StaticResource AutosaveButton}"
                    Content="Load" Click="LoadAutosave_Click"
                    ToolTip="Open the highlighted autosave"/>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="AUTOSAVES" FontSize="11" FontWeight="Bold" Foreground="#93A0B2"/>
            <TextBlock Text="One recoverable point per minute of play. Double-click one to open it."
                       FontSize="10" Foreground="#5C6B7E" Margin="0,2,0,6" TextWrapping="Wrap"/>
            <TextBlock x:Name="AutosaveStatus" FontSize="10" Foreground="#38D7A3" Margin="0,0,0,4" Visibility="Collapsed"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Margin="0,18,0,0">
        <ListBox x:Name="AutosaveList" Background="#080B0F" Foreground="#E7ECF3"
                 BorderBrush="#1E2630" BorderThickness="1" Padding="2"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="AutosaveList_DoubleClick"
                 SelectionChanged="AutosaveList_SelectionChanged">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="10,7"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding ScoreLine}" FontSize="13" FontWeight="Bold" Foreground="#F4F7FB" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#7C8A9C" Margin="0,2,0,0"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="AutosaveEmpty" Text="No autosaves yet — start a game and they appear here."
                   Foreground="#5C6B7E" FontSize="12" Margin="14,18,0,0" IsHitTestVisible="False"/>
      </Grid>
    </DockPanel>

    <Border Grid.Column="1" Background="#0A0D11" BorderBrush="#151B23" BorderThickness="1,0,0,0">
      <TextBlock x:Name="VersionText" Text="a1.41" Foreground="#5C6B7E" FontSize="12" FontWeight="Bold"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22"
                 RenderTransformOrigin="0.5,0.5">
        <TextBlock.RenderTransform>
          <RotateTransform Angle="-90"/>
        </TextBlock.RenderTransform>
      </TextBlock>
    </Border>
  </Grid>
</Window>
