<UserControl x:Class="Scoreboard.Desktop.MediaDock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" Foreground="{DynamicResource DockText}">
  <UserControl.Resources>
    <SolidColorBrush x:Key="DockPanel" Color="#080808"/>
    <SolidColorBrush x:Key="DockSurface" Color="#141414"/>
    <SolidColorBrush x:Key="DockBorder" Color="#383838"/>
    <SolidColorBrush x:Key="DockText" Color="#F4F7FB"/>
    <SolidColorBrush x:Key="DockMuted" Color="#93A0B2"/>
    <SolidColorBrush x:Key="DockInput" Color="#050505"/>
    <SolidColorBrush x:Key="DockTrack" Color="#26313D"/>
    <SolidColorBrush x:Key="DockThumb" Color="#EAF0F7"/>
    <SolidColorBrush x:Key="DockRail" Color="#10151D"/>
    <SolidColorBrush x:Key="DockAccent" Color="#38D7A3"/>

    <Style x:Key="TileGlyph" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="Foreground" Value="{DynamicResource DockAccent}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Background" Value="{DynamicResource DockSurface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DockBorder}"/>
      <Setter Property="Foreground" Value="{DynamicResource DockText}"/>
    </Style>
    <Style x:Key="DockAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="9,5"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Margin" Value="3,0,0,0"/>
      <Setter Property="Background" Value="{DynamicResource DockSurface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DockBorder}"/>
      <Setter Property="Foreground" Value="{DynamicResource DockText}"/>
    </Style>
    <Style x:Key="ClearAction" TargetType="Button" BasedOn="{StaticResource DockAction}">
      <Setter Property="Foreground" Value="#FFD166"/>
      <Setter Property="BorderBrush" Value="#6B5A2A"/>
    </Style>

    <Style x:Key="DockLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource DockMuted}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
    <Style x:Key="RailHeading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource DockMuted}"/>
      <Setter Property="Width" Value="50"/>
      <Setter Property="Margin" Value="0,0,5,0"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Padding" Value="0,6,0,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="DockCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Background" Value="{DynamicResource DockInput}"/>
      <Setter Property="Foreground" Value="{DynamicResource DockText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DockBorder}"/>
    </Style>
    <Style x:Key="DockSearch" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="7,5"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Background" Value="{DynamicResource DockInput}"/>
      <Setter Property="Foreground" Value="{DynamicResource DockText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DockBorder}"/>
    </Style>
    <!-- The dock is also used as a full-width tab. These are the same controls at console size,
         defined after their small twins so the BasedOn lookups resolve while parsing. -->
    <Style x:Key="DockActionLarge" TargetType="Button" BasedOn="{StaticResource DockAction}">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="Margin" Value="4,0,0,0"/>
    </Style>
    <Style x:Key="TransportButtonLarge" TargetType="Button" BasedOn="{StaticResource TransportButton}">
      <Setter Property="Width" Value="58"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
    <Style x:Key="DockComboLarge" TargetType="ComboBox" BasedOn="{StaticResource DockCombo}">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinHeight" Value="38"/>
    </Style>
    <Style x:Key="DockSearchLarge" TargetType="TextBox" BasedOn="{StaticResource DockSearch}">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="10,8"/>
    </Style>
    <Style x:Key="DockCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="{DynamicResource DockMuted}"/>
      <Setter Property="Margin" Value="0,2,8,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <!-- Scrollbars are part of the dock, not the operating system: slim rounded thumbs in the
         dock's own palette instead of the default Windows light bar. -->
    <Style x:Key="DockHScrollBar" TargetType="ScrollBar">
      <Setter Property="Height" Value="10"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border Height="7" Margin="0,1" CornerRadius="4" VerticalAlignment="Center" Background="{DynamicResource DockTrack}" ClipToBounds="True">
              <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Focusable="False">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Height="7" MinWidth="24" Cursor="Hand">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource DockMuted}" CornerRadius="4" Opacity="0.55"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Focusable="False">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
              </Track>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DockVScrollBar" TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border Width="7" Margin="1,0" CornerRadius="4" HorizontalAlignment="Center" Background="{DynamicResource DockTrack}" ClipToBounds="True">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="7" MinHeight="24" Cursor="Hand">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource DockMuted}" CornerRadius="4" Opacity="0.55"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
              </Track>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TransportSlider" TargetType="Slider">
      <Setter Property="Height" Value="26"/>
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid VerticalAlignment="Center">
              <Border Height="7" CornerRadius="4" Background="{DynamicResource DockTrack}"/>
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="7" CornerRadius="4" Background="{DynamicResource DockAccent}"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="16" Height="16" Cursor="Hand">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="16" Height="16" Fill="{DynamicResource DockThumb}" Stroke="{DynamicResource DockAccent}" StrokeThickness="2"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Border x:Name="Chrome" Background="{DynamicResource DockPanel}" CornerRadius="9" Padding="11,9">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="232"/>
      </Grid.ColumnDefinitions>

      <!-- The library owns the wide side; every add/route/live/replay control lives in the rail
           on the right, so clips get the full height and width instead of a stack of toolbars. -->
      <StackPanel Grid.Column="0" Margin="0,0,0,5">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="RemoveButton" Content="Remove" Style="{StaticResource DockAction}" Click="Remove_Click" ToolTip="Remove the selected clip from the library"/>
            <Button Content="Import" Style="{StaticResource DockAction}" Click="Import_Click" ToolTip="Import audio or video clips"/>
            <Button Content="Clear" Style="{StaticResource ClearAction}" Click="Clear_Click"
                    ToolTip="Stop playback, close the camera and blank every scorebug video box"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Width="3" Height="12" CornerRadius="2" Background="{DynamicResource DockAccent}" Margin="0,0,6,0"/>
            <TextBlock Text="MEDIA" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource DockMuted}" VerticalAlignment="Center"/>
            <TextBlock x:Name="HintText" Text="  tags route to the scorebug · folders organise" FontSize="10" Foreground="{DynamicResource DockMuted}" Opacity="0.7" VerticalAlignment="Center" Visibility="Collapsed"/>
          </StackPanel>
        </DockPanel>
      </StackPanel>

      <Border Grid.Column="2" Grid.RowSpan="11" Background="{DynamicResource DockRail}" CornerRadius="9" Padding="10,8" Margin="0,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <DockPanel Margin="0,0,0,8">
              <Border Width="3" Height="12" CornerRadius="2" Background="{DynamicResource DockAccent}" Margin="0,0,6,0"/>
              <TextBlock Text="ADD &amp; ROUTE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DockMuted}" VerticalAlignment="Center"/>
            </DockPanel>

            <TextBlock Text="CAMERA" Style="{StaticResource DockLabel}" Margin="0,0,0,3"/>
            <WrapPanel Margin="0,0,0,7">
              <Button Content="Add camera" Style="{StaticResource DockAction}" Click="Camera_Click" ToolTip="Add the next capture device to the library — it routes by tag like any other clip"/>
              <Button x:Name="RouteButton" Content="Route…" Style="{StaticResource DockAction}" Click="Route_Click"
                      ToolTip="Rename the selected camera item and choose which camera it uses"/>
            </WrapPanel>
            <WrapPanel Margin="0,0,0,9">
              <Button x:Name="ReplayButton" Content="Replay" Style="{StaticResource DockAction}" Click="Replay_Click"
                      ToolTip="Freeze the last two minutes of the live camera on the scorebug so you can drag back to the start of the play"/>
              <Button x:Name="LiveButton" Content="Live" Style="{StaticResource DockAction}" Click="Live_Click"
                      ToolTip="Jump back to the live camera"/>
            </WrapPanel>

            <TextBlock Text="MICROPHONE" Style="{StaticResource DockLabel}" Margin="0,0,0,3"/>
            <WrapPanel Margin="0,0,0,4">
              <Button Content="Add microphone" Style="{StaticResource DockAction}" Click="Microphone_Click"
                      ToolTip="Add a capture device to the library. Cue it and its sound goes live on the output set below"/>
              <Button x:Name="MicrophoneRouteButton" Content="Route…" Style="{StaticResource DockAction}" Click="MicrophoneRoute_Click"
                      ToolTip="Rename the selected microphone item and choose which microphone it listens to"/>
            </WrapPanel>
            <TextBlock x:Name="MicrophoneStatus" Text="" FontSize="10" Foreground="{DynamicResource DockMuted}" Opacity="0.75"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>

            <TextBlock Text="SPEAKER" Style="{StaticResource DockLabel}" Margin="0,0,0,3"/>
            <WrapPanel Margin="0,0,0,4">
              <Button Content="Add speaker" Style="{StaticResource DockAction}" Click="Speaker_Click"
                      ToolTip="Add an output device as a speaker bus, then use the SPEAKER dropdown and VOLUME slider to control it"/>
              <Button x:Name="SpeakerRouteButton" Content="Route…" Style="{StaticResource DockAction}" Click="SpeakerRoute_Click"
                      ToolTip="Rename the selected speaker bus and choose which output device it uses"/>
            </WrapPanel>
            <TextBlock x:Name="SpeakerStatus" Text="" FontSize="10" Foreground="{DynamicResource DockMuted}" Opacity="0.75"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>

            <TextBlock Text="LIVE CAMERA" Style="{StaticResource DockLabel}" Margin="0,0,0,3"/>
            <ComboBox x:Name="CameraBox" Style="{StaticResource DockCombo}" SelectionChanged="Camera_Changed"
                      ToolTip="Choose which camera item is on air"/>

            <TextBlock Text="REPLAY" Style="{StaticResource DockLabel}" Margin="0,7,0,3"/>
            <WrapPanel>
              <Button x:Name="StartReplayButton" Style="{StaticResource DockAction}" Content="Start replay" Click="StartReplay_Click"
                      IsEnabled="False"
                      ToolTip="Put the replay on air at the frame you have scrubbed to; Play rolls it"/>
              <Button x:Name="JumpToLiveButton" Style="{StaticResource DockAction}" Content="↩ Jump to live" Click="Live_Click"
                      IsEnabled="False" ToolTip="Leave the replay and go straight back to the live camera"/>
              <Button x:Name="SaveReplayButton" Style="{StaticResource DockAction}" Content="Save replay…" Click="SaveReplay_Click"
                      IsEnabled="False"
                      ToolTip="Save everything from where the replay is paused through to now as a clip on your computer"/>
            </WrapPanel>
            <TextBlock x:Name="ReplayHint" Text="Scrub back, start it, then save from there to now." FontSize="10"
                       Foreground="{DynamicResource DockMuted}" Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Search is library-wide: it deliberately ignores the open folder so a clip is never
           hidden just because it lives in a folder or on a playlist. -->
      <Grid Grid.Column="0" Grid.Row="1" Margin="0,0,0,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="SEARCH" Style="{StaticResource DockLabel}"/>
        <Grid Grid.Column="1">
          <TextBox x:Name="SearchBox" Style="{StaticResource DockSearch}" TextChanged="Search_Changed"
                   ToolTip="Search every clip, folder and playlist, wherever it is filed"/>
          <TextBlock x:Name="SearchPrompt" Text="clips, folders, playlists" FontSize="10"
                     Foreground="{DynamicResource DockMuted}" Opacity="0.65"
                     VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"/>
        </Grid>
        <Button x:Name="SearchClearButton" Grid.Column="2" Style="{StaticResource DockAction}"
                Content="✕" Width="30" Padding="0" Margin="3,0,0,0" Visibility="Collapsed"
                Click="ClearSearch_Click" ToolTip="Clear the search"/>
      </Grid>

      <!-- The browser is a file explorer: folders and playlists are items in the grid below,
           and this bar is where you go back out, make a folder, or move a folder in and out. -->
      <StackPanel x:Name="BrowserBar" Grid.Column="0" Grid.Row="2" Margin="0,0,0,5">
        <DockPanel Margin="0,0,0,4">
          <Button x:Name="UpButton" DockPanel.Dock="Right" Style="{StaticResource DockAction}" Content="← Back"
                  Click="Up_Click" ToolTip="Back to the folder you came from"/>
          <TextBlock Text="PATH" Style="{StaticResource DockLabel}"/>
          <TextBlock x:Name="BreadcrumbText" Text="LIBRARY" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" ToolTip="Where you are in the media library"/>
        </DockPanel>
        <WrapPanel x:Name="BrowserActions">
          <Button Content="+ Folder" Style="{StaticResource DockAction}" Click="NewFolder_Click"
                  ToolTip="Make a folder inside the open folder — folders can hold folders"/>
          <Button Content="+ Playlist" Style="{StaticResource DockAction}" Click="NewPlaylist_Click"
                  ToolTip="Make a playlist of clips that run one after another"/>
          <Button Content="Import folder…" Style="{StaticResource DockAction}" Click="ImportFolder_Click"
                  ToolTip="Bring in a ScorePlus Folder (.spf) — clips, nested folders, tags and all"/>
          <Button x:Name="ExportFolderButton" Content="Export folder…" Style="{StaticResource DockAction}" Click="ExportFolder_Click"
                  ToolTip="Save the selected folder and everything inside it as a ScorePlus Folder (.spf)"/>
        </WrapPanel>
      </StackPanel>

      <Grid Grid.Column="0" Grid.Row="4" Margin="0,0,0,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="BackToLibraryButton" Style="{StaticResource DockAction}" Content="← Back" Margin="0,0,8,0"
                Visibility="Collapsed" Click="BackToLibrary_Click" ToolTip="Back to the media library"/>
        <DockPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,5,0">
          <TextBlock x:Name="ViewTitle" DockPanel.Dock="Left" Text="LIBRARY" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
          <TextBlock x:Name="ViewMeta" Text="" FontSize="10" Foreground="{DynamicResource DockMuted}" Margin="7,0,0,0" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <StackPanel x:Name="PlaylistActions" Grid.Column="2" Orientation="Horizontal" Visibility="Collapsed">
          <Button x:Name="PlaylistAddButton" Content="Add clip" Style="{StaticResource DockAction}" Click="PlaylistAdd_Click" ToolTip="Add the selected library clip to this playlist"/>
          <Button x:Name="PlaylistRunButton" Content="Play" Style="{StaticResource DockAction}" Click="PlaylistRun_Click" ToolTip="Play this playlist from the first clip"/>
          <Button x:Name="PlaylistStopButton" Content="Stop" Style="{StaticResource DockAction}" Click="PlaylistStop_Click" ToolTip="Stop playback"/>
          <Button x:Name="PlaylistDeleteButton" Content="Delete" Style="{StaticResource DockAction}" Click="PlaylistDelete_Click" ToolTip="Delete this playlist (the clips stay in the library)"/>
        </StackPanel>
      </Grid>

      <ScrollViewer Grid.Column="0" Grid.Row="5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,1,0,6">
        <ScrollViewer.Resources>
          <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource DockVScrollBar}"/>
        </ScrollViewer.Resources>
        <WrapPanel x:Name="Tiles"/>
      </ScrollViewer>
      <TextBlock x:Name="EmptyText" Grid.Column="0" Grid.Row="5" Text="No media yet — Import adds anthems, ads and clips. Give each clip a tag so scorebug video elements know what to show."
                 Foreground="{DynamicResource DockMuted}" FontSize="11" TextWrapping="Wrap" Margin="2,6,8,0"/>

      <Grid Grid.Column="0" Grid.Row="6" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="PlayPauseButton" Style="{StaticResource TransportButton}" Content="▶" Click="PlayPause_Click" ToolTip="Play or pause the selected clip"/>
        <TextBlock x:Name="ElapsedText" Grid.Column="1" Text="00:00" Foreground="{DynamicResource DockText}" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center" Margin="2,0,8,0"/>
        <Slider x:Name="ScrubBar" Grid.Column="2" Minimum="0" Maximum="1" Value="0" VerticalAlignment="Center"
                Style="{StaticResource TransportSlider}" SmallChange="1" LargeChange="10"
                ToolTip="Click or drag to jump anywhere in the clip"
                PreviewMouseLeftButtonDown="Scrub_Start" PreviewMouseLeftButtonUp="Scrub_End"
                ValueChanged="Scrub_Changed"/>
        <TextBlock x:Name="DurationText" Grid.Column="3" Text="—" Foreground="{DynamicResource DockMuted}" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center" Margin="8,0,8,0"/>
        <Button x:Name="StopButton" Grid.Column="4" Style="{StaticResource TransportButton}" Content="■" Click="Stop_Click" Margin="0" ToolTip="Stop playback and clear the scorebug video overlay"/>
      </Grid>

      <!-- Tags stay a picker: they are a routing rule, not a place in the library. -->
      <Grid Grid.Column="0" Grid.Row="7" Margin="0,0,0,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="TAG" Style="{StaticResource DockLabel}"/>
        <ComboBox x:Name="TagBox" Grid.Column="1" Style="{StaticResource DockCombo}" IsEditable="True"
                  ToolTip="Clips with this tag are the only ones a matching scorebug video element will show"/>
        <Button Grid.Column="2" Content="Set tag" Style="{StaticResource DockAction}" Click="TagApply_Click" ToolTip="Apply this tag to the selected clip"/>
      </Grid>

      <Grid Grid.Column="0" Grid.Row="8" Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <CheckBox x:Name="ClipLoopBox" Content="Loop this clip" Style="{StaticResource DockCheck}"
                    Checked="ClipLoop_Changed" Unchecked="ClipLoop_Changed"
                    ToolTip="Play this clip again when it ends (a playlist still moves on)"/>
          <CheckBox x:Name="PlaylistLoopBox" Content="Loop playlist" Style="{StaticResource DockCheck}"
                    Checked="PlaylistLoop_Changed" Unchecked="PlaylistLoop_Changed"
                    Visibility="Collapsed"
                    ToolTip="Start the playlist again after the last clip"/>
        </StackPanel>
        <TextBlock x:Name="ClipCountText" Grid.Column="1" Text="" FontSize="10" Foreground="{DynamicResource DockMuted}" VerticalAlignment="Center"/>
      </Grid>

      <!-- Audio for the selected clip: its own level, and which speaker it comes out of. -->
      <Grid Grid.Column="0" Grid.Row="9" Margin="0,5,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="VOLUME" Style="{StaticResource DockLabel}" VerticalAlignment="Center"/>
        <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="100"
                Style="{StaticResource TransportSlider}" VerticalAlignment="Center" Margin="4,0,6,0"
                SmallChange="5" LargeChange="10" ToolTip="This clip's own output level"
                ValueChanged="Volume_Changed"/>
        <TextBlock x:Name="VolumeText" Grid.Column="2" Text="100%" FontFamily="Consolas" FontSize="11"
                   Foreground="{DynamicResource DockMuted}" VerticalAlignment="Center" Width="42" TextAlignment="Right"/>
      </Grid>

      <Grid Grid.Column="0" Grid.Row="10" Margin="0,4,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="SPEAKER" Style="{StaticResource DockLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <ComboBox x:Name="AudioDeviceBox" Grid.Column="1" Style="{StaticResource DockCombo}" SelectionChanged="AudioDevice_Changed"
                  ToolTip="Play the selected clip on this speaker — or, with a speaker bus selected, choose that bus's output"/>
      </Grid>
    </Grid>
  </Border>
</UserControl>
