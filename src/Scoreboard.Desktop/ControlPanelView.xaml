<UserControl x:Class="Scoreboard.Desktop.ControlPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Scoreboard.Desktop"
             FontFamily="Segoe UI" Foreground="#F4F7FB" Focusable="False">
  <UserControl.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#171C25"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="#93A0B2"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="#5C6B7E"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- Deliberately not named "Accent": a drop-down's pop-up resolves resources through this view,
         and the accent BRUSH in App.xaml/the window is called Accent. The collision handed the
         pop-up's BorderBrush a Style and the console died with an InvalidCastException the moment a
         penalty list opened. -->
    <Style x:Key="AccentBar" TargetType="Border">
      <Setter Property="Width" Value="3"/>
      <Setter Property="Height" Value="12"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="Background" Value="#38D7A3"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
    <!-- Based on the app button so the clock and step rows share the rounded chrome of the
         score steppers instead of falling back to the flat system button. -->
    <Style x:Key="Tiny" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontSize" Value="12"/>
      <!-- Tall enough to hit without aiming: a rectangle, not a sliver. -->
      <Setter Property="Padding" Value="8,8"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="MinWidth" Value="36"/>
      <Setter Property="Margin" Value="2"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource Tiny}">
      <Setter Property="Margin" Value="2,3,2,0"/>
    </Style>
    <Style x:Key="NameBox" TargetType="TextBox">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="6,2"/>
      <!-- One line of type high, centred beside the logo: the field must not stretch to the
           logo's height and leave a fat empty band above and below the name. -->
      <Setter Property="Height" Value="36"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Margin" Value="6,0"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="ToolTip" Value="Team name — press Enter or click away to save"/>
    </Style>
    <Style x:Key="ClockBox" TargetType="TextBox">
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="23"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="2"/>
      <Setter Property="Margin" Value="4,0"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="ToolTip" Value="Click and type a value to set it exactly, then press Enter"/>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" MinHeight="226"/>
      <RowDefinition Height="*" MinHeight="210"/>
      <RowDefinition Height="196" MinHeight="196"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ============ VISITORS / HOME ============ -->
    <Grid Grid.Row="0" Margin="0,0,0,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}" Grid.Column="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DockPanel>
            <TextBlock x:Name="AwayPossessionTag" DockPanel.Dock="Right" Text="" Foreground="#38D7A3" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource AccentBar}"/>
              <TextBlock Text="VISITORS" Style="{StaticResource CardTitle}"/>
            </StackPanel>
          </DockPanel>
          <!-- Team name with its logo and the details button: name, abbreviation, logo, colors. -->
          <Grid Grid.Row="1" Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="AwayLogoFrame" Width="64" Height="64" CornerRadius="8" Background="#0A0F16"
                    BorderBrush="#2C3745" BorderThickness="1" Padding="4" VerticalAlignment="Center">
              <Image x:Name="AwayLogoImage" Stretch="Uniform"/>
            </Border>
            <TextBox x:Name="AwayName" Grid.Column="1" Style="{StaticResource NameBox}" Margin="6,2,6,4"/>
            <Button x:Name="AwayDetailsButton" Grid.Column="2" Content="…" Width="40" MinHeight="38"
                    Padding="0" FontSize="18" VerticalAlignment="Center" Click="AwayDetails_Click"
                    ToolTip="Team name, abbreviation, logo, primary and secondary colors"/>
          </Grid>
          <!-- Auto, not star: the score stepper keeps its full height, including the − row. -->
          <ContentControl x:Name="AwayScoreHost" Grid.Row="2" VerticalAlignment="Center" Margin="0,4,0,0"/>
        </Grid>
      </Border>

      <Border Style="{StaticResource Card}" Grid.Column="1" Margin="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <!-- Mirrored against the visitors card: possession sits on the inside edge, the team
               heading on the outside edge, so the pair reads symmetrically across the panel. -->
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
              <TextBlock Text="HOME" Style="{StaticResource CardTitle}"/>
              <Border Style="{StaticResource AccentBar}" Margin="6,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="HomePossessionTag" Text="" Foreground="#38D7A3" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
          </DockPanel>
          <Grid Grid.Row="1" Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="HomeDetailsButton" Content="…" Width="40" MinHeight="38" Padding="0" FontSize="18"
                    VerticalAlignment="Center" Click="HomeDetails_Click"
                    ToolTip="Team name, abbreviation, logo, primary and secondary colors"/>
            <TextBox x:Name="HomeName" Grid.Column="1" Style="{StaticResource NameBox}" Margin="6,2,6,4"/>
            <Border x:Name="HomeLogoFrame" Grid.Column="2" Width="64" Height="64" CornerRadius="8" Background="#0A0F16"
                    BorderBrush="#2C3745" BorderThickness="1" Padding="4" VerticalAlignment="Center">
              <Image x:Name="HomeLogoImage" Stretch="Uniform"/>
            </Border>
          </Grid>
          <ContentControl x:Name="HomeScoreHost" Grid.Row="2" VerticalAlignment="Center" Margin="0,4,0,0"/>
        </Grid>
      </Border>
    </Grid>

    <!-- ============ DOWN & DISTANCE (football) + TIMING ============ -->
    <Grid Grid.Row="1" Margin="0,0,0,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}" Grid.Column="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DockPanel>
            <!-- The down's own two actions ride in the title row. Under the penalty strip they
                 formed a second row, and the two together were taller than this card, so they
                 were the part that got clipped. -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="NewSeriesButton" Style="{StaticResource Tiny}" Content="New series" Tag="football.series.new" Click="Action_Click"/>
              <Button x:Name="RecallDownButton" Style="{StaticResource Tiny}" Content="↺ Last down" Tag="football.down.recall" Click="Action_Click"
                      ToolTip="Put the down, distance and ball spot back where they were before the last change"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Style="{StaticResource AccentBar}"/>
              <TextBlock x:Name="DetailCardTitle" Text="DOWN &amp; DISTANCE" Style="{StaticResource CardTitle}"/>
              <TextBlock x:Name="DetailCardHint" Style="{StaticResource Caption}" Text="the sport's live values"
                         Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
            </StackPanel>
          </DockPanel>

          <!-- Football -->
          <StackPanel x:Name="FootballDetail" Grid.Row="1" Margin="0,4,0,0" VerticalAlignment="Top">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <ContentControl x:Name="DownHost" Grid.Column="0"/>
              <ContentControl x:Name="ToGoHost" Grid.Column="1"/>
              <ContentControl x:Name="BallOnHost" Grid.Column="2"/>
            </Grid>
            <!-- The down-line type is stepped with arrows rather than opened as a list, so the
                 operator can move Yards → Goal → PAT → 2 PT without leaving the console row. -->
            <Grid x:Name="FootballModePicker" Margin="0,4,0,0" Height="38" MinHeight="38">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="FootballModePrevButton" Grid.Column="0" Style="{StaticResource Tiny}"
                      Margin="0" MinWidth="42" Height="38" MinHeight="38" Padding="0"
                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                      VerticalAlignment="Stretch" Click="FootballModePrev_Click" ToolTip="Previous down-line type">
                <Path Width="11" Height="14" Stretch="Fill"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                      Data="M 11,0 L 0,7 L 11,14 Z"/>
              </Button>
              <Border Grid.Column="1" Background="#0B1118" CornerRadius="5" Margin="4,0"
                      BorderBrush="#2C3745" BorderThickness="1">
                <TextBlock x:Name="FootballModeLabel" Text="Yards" FontSize="13" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           ToolTip="How the down line prints: yards to go, Goal, PAT, 2 PT ATT, or no line"/>
              </Border>
              <Button x:Name="FootballModeNextButton" Grid.Column="2" Style="{StaticResource Tiny}"
                      Margin="0" MinWidth="42" Height="38" MinHeight="38" Padding="0"
                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                      VerticalAlignment="Stretch" Click="FootballModeNext_Click" ToolTip="Next down-line type">
                <Path Width="11" Height="14" Stretch="Fill"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                      Data="M 0,0 L 11,7 L 0,14 Z"/>
              </Button>
            </Grid>
          </StackPanel>

          <!-- Every sport's own values — balls, bases, power play, overs, sets — as compact
               steppers and switches. Built in code from the game's sport controls. -->
          <WrapPanel x:Name="OtherDetail" Grid.Row="2" Margin="0,4,0,0" VerticalAlignment="Top"/>

          <!-- The penalty strip shares this card rather than taking a row of its own: it is the
               same drive as the down, it only needs a line, and the row it used to claim came out
               of the timing column below, which is what clipped the play clock. -->
          <DockPanel x:Name="PenaltyStrip" Grid.Row="3" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
              <ToggleButton x:Name="PenaltyActiveToggle" Content="No flag" MinHeight="32"
                            Padding="10,2" Checked="Penalty_Changed" Unchecked="Penalty_Changed"
                            ToolTip="Whether a flag is down at all"/>
              <ComboBox x:Name="PenaltyTypeBox" Width="132" MinHeight="30" Margin="6,0,0,0"
                        SelectionChanged="Penalty_Changed"
                        ToolTip="What the flag was given for — holding, offside, handball and the rest"/>
              <ComboBox x:Name="PenaltyTeamBox" Width="132" MinHeight="30" Margin="6,0,0,0"
                        SelectionChanged="Penalty_Changed"
                        ToolTip="Which team the flag is against"/>
            </StackPanel>
            <TextBlock x:Name="PenaltyHint" Style="{StaticResource Caption}" VerticalAlignment="Center"
                       Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                       Text="No flag down. Update Output puts one on air."/>
          </DockPanel>

        </Grid>
      </Border>

      <Border Style="{StaticResource Card}" Grid.Column="1" Margin="0">
        <!-- The timing column holds the most rows in the console, so it scrolls rather than
             clipping when the window is short: a cut-off clock button is worse than a scrollbar. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <!-- Quarter rides in the title row: - / value / +, same button size as the rest, but
               it no longer costs a whole row of its own. -->
          <DockPanel>
            <ContentControl x:Name="QuarterHost" DockPanel.Dock="Right" VerticalAlignment="Center"/>
            <!-- The audience-clock message lives in the header, not over the clock value. -->
            <ComboBox x:Name="ClockMessageBox" DockPanel.Dock="Right" Width="132" Height="28"
                      Margin="8,0,24,0" FontSize="11"
                      SelectionChanged="ClockMessage_Changed"
                      ToolTip="What the game clock prints on the graphic">
              <ComboBoxItem Content="Game clock" Tag="Clock"/>
              <ComboBoxItem Content="Final" Tag="Final"/>
              <ComboBoxItem Content="End of Reg." Tag="EndOfRegulation"/>
            </ComboBox>
            <TextBlock Text="CLOCK SHOWS" DockPanel.Dock="Right" Style="{StaticResource Caption}"
                       Margin="10,0,6,0"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Style="{StaticResource AccentBar}"/>
              <TextBlock Text="TIMING" Style="{StaticResource CardTitle}"/>
            </StackPanel>
          </DockPanel>

          <!-- Game clock: type over the value, or step it a second or a minute at a time. -->
          <Grid Grid.Row="2" Margin="0,2,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="GAME CLOCK" Style="{StaticResource Caption}" Margin="0,0,8,0"/>
              <TextBox x:Name="ClockValue" Grid.Column="1" Style="{StaticResource ClockBox}" KeyDown="ClockValue_KeyDown" LostKeyboardFocus="ClockValue_LostFocus"/>
              <Button x:Name="ClockToggle" Grid.Column="2" Style="{StaticResource Tiny}" Content="Start" Tag="clock.toggle" Click="Action_Click"/>
              <Button Grid.Column="3" Style="{StaticResource Tiny}" Content="Set" Tag="clock.set" Click="Action_Click"/>
            </Grid>
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,1,0,0">
              <Button Style="{StaticResource CardButton}" Content="−1:00" Tag="clock.minus60" Click="Action_Click" ToolTip="Clock −1 minute"/>
              <Button Style="{StaticResource CardButton}" Content="−0:01" Tag="clock.minus1" Click="Action_Click" ToolTip="Clock −1 second"/>
              <Button Style="{StaticResource CardButton}" Content="+0:01" Tag="clock.plus1" Click="Action_Click" ToolTip="Clock +1 second"/>
              <Button Style="{StaticResource CardButton}" Content="+1:00" Tag="clock.plus60" Click="Action_Click" ToolTip="Clock +1 minute"/>
            </UniformGrid>
          </Grid>

          <!-- Soccer's added time: start it while the game is stopped, stop it when play resumes.
               The game clock then runs past 90:00 for exactly what this clock collected. -->
          <Grid x:Name="StoppageRow" Margin="0,2,0,0" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="STOPPAGE" Style="{StaticResource Caption}" Margin="0,0,8,0"/>
              <TextBox x:Name="StoppageValue" Grid.Column="1" Style="{StaticResource ClockBox}" IsReadOnly="True"
                       ToolTip="Added time accrued: the game clock runs this long past 90:00"/>
              <Button x:Name="StoppageToggle" Grid.Column="2" Style="{StaticResource Tiny}" Content="Start"
                      Tag="clock.stoppage.toggle" Click="Action_Click"/>
              <Button Grid.Column="3" Style="{StaticResource Tiny}" Content="Clear"
                      Tag="clock.stoppage.reset" Click="Action_Click" ToolTip="Clear the accrued added time"/>
            </Grid>
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,1,0,0">
              <Button Style="{StaticResource CardButton}" Content="+0:30" Tag="clock.stoppage.plus30" Click="Action_Click" ToolTip="Add 30 seconds of stoppage"/>
              <Button Style="{StaticResource CardButton}" Content="+1:00" Tag="clock.stoppage.plus60" Click="Action_Click" ToolTip="Add a minute of stoppage"/>
              <Button Style="{StaticResource CardButton}" Content="−0:30" Tag="clock.stoppage.minus30" Click="Action_Click" ToolTip="Remove 30 seconds of stoppage"/>
            </UniformGrid>
          </Grid>

          <Grid x:Name="PlayClockRow" Grid.Row="3" Margin="0,2,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="PLAY CLOCK" Style="{StaticResource Caption}" Margin="0,0,8,0"/>
              <TextBox x:Name="PlayClockValue" Grid.Column="1" Style="{StaticResource ClockBox}" KeyDown="PlayClock_KeyDown" LostKeyboardFocus="PlayClock_LostFocus"/>
              <Button x:Name="PlayClockToggle" Grid.Column="2" Style="{StaticResource Tiny}" Content="Start" Tag="football.playclock.toggle" Click="Action_Click"/>
              <Button Grid.Column="3" Style="{StaticResource Tiny}" Content="Set" Tag="football.playclock.set" Click="Action_Click"/>
            </Grid>
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,1,0,0">
              <Button Style="{StaticResource CardButton}" Content="40" Tag="football.playclock.reset40" Click="Action_Click" ToolTip="Reset the play clock to 40 seconds"/>
              <Button Style="{StaticResource CardButton}" Content="25" Tag="football.playclock.reset25" Click="Action_Click" ToolTip="Reset the play clock to 25 seconds"/>
              <Button Style="{StaticResource CardButton}" Content="−1" Tag="football.playclock.minus" Click="Action_Click" ToolTip="Play clock −1 second"/>
              <Button Style="{StaticResource CardButton}" Content="+1" Tag="football.playclock.plus" Click="Action_Click" ToolTip="Play clock +1 second"/>
            </UniformGrid>
          </Grid>

          <Grid x:Name="ShotClockRow" Grid.Row="4" Margin="0,4,0,0" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="SHOT CLOCK" Style="{StaticResource Caption}" Margin="0,0,8,0"/>
              <TextBox x:Name="ShotClockValue" Grid.Column="1" Style="{StaticResource ClockBox}"
                       KeyDown="ShotClock_KeyDown" LostKeyboardFocus="ShotClock_LostFocus"
                       ToolTip="Click and type a shot clock value, then press Enter"/>
              <Button x:Name="ShotClockToggle" Grid.Column="2" Style="{StaticResource Tiny}" Content="Start" Tag="basketball.shotclock.toggle" Click="Action_Click"/>
            </Grid>
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,1,0,0">
              <Button Style="{StaticResource CardButton}" Content="24" Tag="basketball.shotclock.reset" Click="Action_Click" ToolTip="Reset the shot clock to 24"/>
              <Button Style="{StaticResource CardButton}" Content="14" Click="ShotClock14_Click" ToolTip="Set the shot clock to 14"/>
              <Button Style="{StaticResource CardButton}" Content="−1" Tag="basketball.shotclock.minus" Click="Action_Click" ToolTip="Shot clock −1 second"/>
              <Button Style="{StaticResource CardButton}" Content="+1" Tag="basketball.shotclock.plus" Click="Action_Click" ToolTip="Shot clock +1 second"/>
            </UniformGrid>
          </Grid>
        </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- ============ TIMEOUTS / POSSESSION / TIMEOUT CLOCK / STATS ============ -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="0.8*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="1.2*"/>
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}" Grid.Column="0">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Style="{StaticResource AccentBar}"/>
            <TextBlock Text="TIMEOUTS" Style="{StaticResource CardTitle}"/>
          </StackPanel>
          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ContentControl x:Name="AwayTimeoutsHost"/>
            <ContentControl x:Name="HomeTimeoutsHost" Grid.Column="1"/>
          </Grid>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Grid.Column="1">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Style="{StaticResource AccentBar}"/>
            <TextBlock Text="POSSESSION" Style="{StaticResource CardTitle}"/>
          </StackPanel>
          <TextBlock x:Name="PossessionValue" Text="VISITORS" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,4"/>
          <UniformGrid Columns="2">
            <Button x:Name="AwayPossessionButton" Style="{StaticResource Tiny}" Content="◀ AWAY" Tag="possession.away" Click="Action_Click" ToolTip="Give the visitors possession"/>
            <Button x:Name="HomePossessionButton" Style="{StaticResource Tiny}" Content="HOME ▶" Tag="possession.home" Click="Action_Click" ToolTip="Give the home team possession"/>
          </UniformGrid>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Grid.Column="2">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Style="{StaticResource AccentBar}"/>
            <TextBlock Text="TIMEOUT CLOCK" Style="{StaticResource CardTitle}"/>
          </StackPanel>
          <TextBox x:Name="TimeoutClockValue" Text="1:00" Style="{StaticResource ClockBox}" FontSize="30"
                   KeyDown="TimeoutClock_KeyDown" LostKeyboardFocus="TimeoutClock_LostFocus"
                   ToolTip="Click and type M:SS, then press Enter"/>
          <UniformGrid Columns="3">
            <Button Style="{StaticResource Tiny}" Content="↺ 1:00" Tag="timeoutclock.reset" Click="Action_Click" ToolTip="Reset the timeout clock to one minute"/>
            <Button x:Name="TimeoutClockToggle" Style="{StaticResource Tiny}" Content="Start" Tag="timeoutclock.toggle" Click="Action_Click"/>
            <Button Style="{StaticResource Tiny}" Content="Set" Tag="timeoutclock.set" Click="Action_Click"/>
          </UniformGrid>
          <UniformGrid Columns="4" Margin="0,1,0,0">
            <Button Style="{StaticResource CardButton}" Content="−0:10" Tag="timeoutclock.minus10" Click="Action_Click" ToolTip="Timeout clock −10 seconds"/>
            <Button Style="{StaticResource CardButton}" Content="−0:01" Tag="timeoutclock.minus1" Click="Action_Click" ToolTip="Timeout clock −1 second"/>
            <Button Style="{StaticResource CardButton}" Content="+0:01" Tag="timeoutclock.plus1" Click="Action_Click" ToolTip="Timeout clock +1 second"/>
            <Button Style="{StaticResource CardButton}" Content="+0:10" Tag="timeoutclock.plus10" Click="Action_Click" ToolTip="Timeout clock +10 seconds"/>
          </UniformGrid>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Grid.Column="3" Margin="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Tiny}" Content="＋ Add" Click="AddStat_Click"/>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource AccentBar}"/>
              <TextBlock Text="CUSTOM VALUES" Style="{StaticResource CardTitle}"/>
            </StackPanel>
          </DockPanel>
          <!-- The stat list is the one thing that can outgrow its card, so it scrolls in place and never pushes the page. -->
          <ScrollViewer x:Name="StatsScroller" Grid.Row="1" Margin="0,3,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <UniformGrid x:Name="StatsHost" Columns="2" VerticalAlignment="Top"/>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- ============ PUBLISH BAR ============ -->
    <Border Grid.Row="3" Background="#111721" CornerRadius="9" Padding="9,6" Margin="0,8,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <ComboBox x:Name="HornType" Width="108" MinHeight="32" Margin="0,0,4,0"
                    SelectionChanged="HornType_Changed" ToolTip="Choose the horn sound">
            <ComboBoxItem Content="Air horn" Tag="AirHorn"/>
            <ComboBoxItem Content="Buzzer" Tag="Buzzer"/>
            <ComboBoxItem Content="Siren" Tag="Siren"/>
            <ComboBoxItem Content="Custom…" Tag="Custom"/>
          </ComboBox>
          <Button x:Name="HornButton" Content="HORN" MinWidth="62" MinHeight="36" Padding="10,6"
                  Background="#8D2B2B" BorderBrush="#D65B5B" Foreground="#FFF4F4" FontWeight="Bold"
                  Click="Horn_Click" ToolTip="Play the selected horn"/>
          <Button x:Name="HornPickButton" Content="…" MinWidth="30" MinHeight="36" Padding="4,6"
                  Margin="3,0,8,0" Click="HornPick_Click" ToolTip="Choose a custom horn audio file"/>
          <Border Background="#171C25" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="LAYOUT" FontSize="10" FontWeight="Bold" Foreground="#7C8A9C" VerticalAlignment="Center" Margin="2,0,5,0"/>
              <Button x:Name="LayoutPrevButton" Style="{StaticResource Tiny}" Content="◀" Click="LayoutPrev_Click" ToolTip="Previous scorebug layout"/>
              <TextBlock x:Name="LayoutLabel" Text="1 · Broadcast Classic" FontSize="11" FontWeight="SemiBold" MinWidth="140" TextAlignment="Center" VerticalAlignment="Center" Margin="4,0"/>
              <Button x:Name="LayoutNextButton" Style="{StaticResource Tiny}" Content="▶" Click="LayoutNext_Click" ToolTip="Next scorebug layout"/>
            </StackPanel>
          </Border>
          <ToggleButton x:Name="LiveOutputToggle" Content="Live: ON" IsChecked="True" Checked="LiveOutput_Changed" Unchecked="LiveOutput_Changed" Padding="12,8" MinHeight="36" FontSize="12" Width="92" ToolTip="Publish score, clocks and team names as they change"/>
          <Button x:Name="UpdateButton" Content="Update Output" FontSize="13" Padding="16,10" MinHeight="40" Background="#0B6B50" BorderBrush="#14A67C" Tag="output.publish" Click="Action_Click" Margin="6,0,0,0" ToolTip="Publish down, distance, possession, timeouts, stats and the chosen layout"/>
        </StackPanel>
        <TextBlock x:Name="StagedText" Text="EVERYTHING ON AIR" FontSize="11" FontWeight="Bold" Foreground="#38D7A3" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
