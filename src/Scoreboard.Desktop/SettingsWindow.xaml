<Window x:Class="Scoreboard.Desktop.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Scoreboard.Desktop" Title="ScorePlus — Preferences" PreviewKeyDown="Window_PreviewKeyDown" Width="560" SizeToContent="Height" MaxHeight="940" MinHeight="380" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#171C25" Foreground="#F4F7FB" FontFamily="Segoe UI">
  <DockPanel Margin="22">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
      <TextBlock Text="Preferences are stored locally." VerticalAlignment="Center" Foreground="#93A0B2" FontSize="11"/>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Save" IsDefault="True" Click="Save_Click"/>
        <Button Content="Cancel" Click="Done_Click"/>
      </StackPanel>
    </DockPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="PREFERENCES" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
        <TextBlock Text="APPEARANCE" Foreground="#93A0B2" FontSize="11" Margin="4,0,0,2"/>
        <ComboBox x:Name="ThemeSelector" SelectionChanged="Theme_Changed"/>
        <TextBlock Text="System follows the Windows app theme (Settings → Personalisation → Colors), so the panels match your desktop. Dark and Light pin one. Applies to operator windows only: scorebug and audience graphics keep their designed colors." TextWrapping="Wrap" Foreground="#93A0B2" FontSize="11" Margin="6,4,6,14"/>
        <Separator/>
        <TextBlock Text="OPERATOR WORKFLOW" Foreground="#93A0B2" FontSize="11" Margin="4,14,0,2"/>
        <CheckBox x:Name="ShowHints" Content="Show tips next to headings (for example 'scoring, timing, actions')" Checked="Controls_Changed" Unchecked="Controls_Changed"/>
        <TextBlock Text="Off by default. Turning it on adds the small explanatory labels in the header, the media dock and the console cards." TextWrapping="Wrap" Foreground="#93A0B2" FontSize="11" Margin="6,4,6,8"/>
        <TextBlock Text="Value switch delay" Foreground="#93A0B2" FontSize="11" Margin="4,10,0,2"/>
        <DockPanel Margin="4,0,4,0">
          <TextBlock DockPanel.Dock="Right" Text="seconds · 0 is instant, 5 is the longest" VerticalAlignment="Center"
                     Foreground="#93A0B2" FontSize="11" Margin="8,0,0,0"/>
          <TextBox x:Name="DelayInput" Width="90" MinHeight="30" Padding="8,4" TextChanged="Delay_Changed"
                   ToolTip="Any value from 0 to 5, for example 0.35"/>
        </DockPanel>
        <TextBlock Text="How long every graphic holds an old value before it switches to the new one. Type any value from 0 to 5; 0 prints instantly and is the default." TextWrapping="Wrap" Foreground="#93A0B2" FontSize="11" Margin="6,4,6,8"/>
        <CheckBox x:Name="QuickPublishInput" Content="Quick layout buttons also update output" Checked="QuickLayout_Changed" Unchecked="QuickLayout_Changed"/>
        <TextBlock Text="Off by default: the four buttons above the sound meter only stage a layout, and Update Output sends it as usual. On, the same press puts the layout on air — faster, but it changes the audience picture without a second confirmation." TextWrapping="Wrap" Foreground="#93A0B2" FontSize="11" Margin="6,2,6,8"/>
        <Separator/>
        <TextBlock Text="CLOCK HORNS" Foreground="#93A0B2" FontSize="11" Margin="4,14,0,2"/>
        <CheckBox x:Name="GameClockHornInput" Content="Sound the horn when the game clock reaches zero" Checked="ClockHorn_Changed" Unchecked="ClockHorn_Changed"/>
        <TextBlock Text="Off by default. Uses the horn selected on the console, including a custom file. It fires once when a running game clock expires; loading or setting a stopped clock to zero is silent." TextWrapping="Wrap" Foreground="#93A0B2" FontSize="11" Margin="6,2,6,8"/>
        <CheckBox x:Name="PlayClockHornInput" Content="Sound the horn when the play clock reaches zero" Checked="ClockHorn_Changed" Unchecked="ClockHorn_Changed"/>
        <TextBlock Text="Off by default. Fires once when a running play clock expires, independently of the game-clock setting." TextWrapping="Wrap" Foreground="#93A0B2" FontSize="11" Margin="6,2,6,8"/>
        <Separator/>
        <TextBlock Text="INTERFACE COLOURS" Foreground="#93A0B2" FontSize="11" Margin="4,14,0,2"/>
        <TextBlock Text="The accent draws selected tabs, live badges and outlines; the secondary fills the main actions such as Update Output. Type a hex value or pick one."
                   TextWrapping="Wrap" Foreground="#93A0B2" FontSize="11" Margin="6,0,6,6"/>
        <Grid Margin="4,0,4,2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border x:Name="AccentSwatch" Width="38" Height="32" CornerRadius="6" BorderThickness="1" BorderBrush="#3A4552"
                  VerticalAlignment="Center" local:ThemeManager.SkipTheme="True"/>
          <TextBox x:Name="AccentInput" Grid.Column="1" MinHeight="32" Padding="8,4" FontFamily="Consolas"
                   TextChanged="Accent_Changed" ToolTip="Accent color, for example #38D7A3"/>
          <Button Grid.Column="2" Content="Choose…" MinHeight="32" Padding="10,4" Margin="6,0,0,0" Click="AccentPick_Click"/>
        </Grid>
        <Grid Margin="4,4,4,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border x:Name="Accent2Swatch" Width="38" Height="32" CornerRadius="6" BorderThickness="1" BorderBrush="#3A4552"
                  VerticalAlignment="Center" local:ThemeManager.SkipTheme="True"/>
          <TextBox x:Name="Accent2Input" Grid.Column="1" MinHeight="32" Padding="8,4" FontFamily="Consolas"
                   TextChanged="Accent_Changed" ToolTip="Secondary color for filled actions, for example #0B6B50"/>
          <Button Grid.Column="2" Content="Choose…" MinHeight="32" Padding="10,4" Margin="6,0,0,0" Click="Accent2Pick_Click"/>
        </Grid>
        <Button x:Name="ResetColorsButton" Content="Reset to the ScorePlus colors" HorizontalAlignment="Left"
                MinHeight="30" Padding="12,4" Margin="4,2,4,2" Click="ResetColors_Click"/>
        <Separator/>
        <TextBlock Text="REMOTE CONTROL" Foreground="#93A0B2" FontSize="11" Margin="4,14,0,2"/>
        <CheckBox x:Name="RemoteEnabledInput" Content="Allow the phone remote on this network" Checked="Remote_Changed" Unchecked="Remote_Changed"/>
        <TextBlock Text="Off by default. The remote serves a copy of this control panel to a phone or tablet on the same network, protected by the password below."
                   TextWrapping="Wrap" Foreground="#93A0B2" FontSize="11" Margin="6,2,6,6"/>
        <Grid Margin="4,0,4,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Password" Foreground="#93A0B2" FontSize="11" Margin="2,0,0,2"/>
            <PasswordBox x:Name="RemotePasswordInput" MinHeight="32" Padding="8,4" Background="#050505"
                         Foreground="#F4F7FB" BorderBrush="#383838" PasswordChanged="Remote_Changed"
                         ToolTip="Required before the remote turns on"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="Port" Foreground="#93A0B2" FontSize="11" Margin="2,0,0,2"/>
            <TextBox x:Name="RemotePortInput" Width="92" MinHeight="32" Padding="8,4" TextChanged="Remote_Changed"
                     ToolTip="1024–65535. The address is shown below."/>
          </StackPanel>
        </Grid>
        <TextBlock x:Name="RemoteStatus" Text="Remote is off." TextWrapping="Wrap" Foreground="#93A0B2" FontSize="11" Margin="6,6,6,4"/>
        <Button x:Name="OpenRemoteButton" Content="Open remote in browser" HorizontalAlignment="Left" MinHeight="30"
                Padding="12,4" Margin="4,2,4,2" Click="OpenRemote_Click" ToolTip="Open the phone console on this computer"/>
        <Separator/>
        <TextBlock Text="UPDATES" Foreground="#93A0B2" FontSize="11" Margin="4,14,0,2"/>
        <CheckBox x:Name="CheckUpdatesInput" Content="Check for a newer version when ScorePlus starts" Checked="Update_Changed" Unchecked="Update_Changed"/>
        <TextBlock Text="Only an installed copy checks. The built-in feed reads this project's GitHub releases, prereleases included, so publishing a release is all it takes — leave the address empty for that. Paste your own manifest URL (JSON: version, url, sha256, notes) to use another host."
                   TextWrapping="Wrap" Foreground="#93A0B2" FontSize="11" Margin="6,2,6,6"/>
        <DockPanel Margin="4,0,4,0">
          <Button DockPanel.Dock="Right" Content="Check now" MinHeight="32" Padding="12,4" Margin="8,0,0,0" Click="CheckUpdates_Click"/>
          <TextBox x:Name="UpdateFeedInput" MinHeight="32" Padding="8,4" TextChanged="Update_Changed"
                   ToolTip="Empty uses the built-in GitHub feed. Or paste https://example.com/scoreplus/win.json"/>
        </DockPanel>
        <TextBlock x:Name="UpdateStatus" Text="Updates are checked only when the app was installed." TextWrapping="Wrap" Foreground="#93A0B2" FontSize="11" Margin="6,4,6,8"/>
        <Separator/>
        <TextBlock Text="GAME SAFETY" Foreground="#93A0B2" FontSize="11" Margin="4,14,0,2"/>
        <Button x:Name="DeleteAutosavesButton" Content="Delete all autosaves" HorizontalAlignment="Left" MinHeight="32"
                Padding="14,6" Click="DeleteAutosaves_Click" Margin="4,4,4,2"
                ToolTip="Remove every recoverable point from this computer. Saved .spg games are not touched."/>
        <TextBlock x:Name="AutosaveStatus" Text="Autosave keeps a recovery point every few seconds while you work."
                   TextWrapping="Wrap" Foreground="#93A0B2" FontSize="11" Margin="6,2,6,4"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
