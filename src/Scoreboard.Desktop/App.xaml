<Application x:Class="Scoreboard.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Scoreboard.Desktop">
  <Application.Resources>
    <SolidColorBrush x:Key="Panel" Color="#080808"/>
    <SolidColorBrush x:Key="Surface" Color="#141414"/>
    <SolidColorBrush x:Key="Accent" Color="#38D7A3"/>
    <SolidColorBrush x:Key="Muted" Color="#A8B4C3"/>

    <!-- The controls read these, not hard-coded shades, so a button created after the theme pass
         (a score stepper, a rebuilt sport row) is painted like the ones around it. ThemeManager
         replaces them per window; the dark values here are the startup fallback. -->
    <SolidColorBrush x:Key="OperatorPanelBrush" Color="#080808"/>
    <SolidColorBrush x:Key="OperatorSurfaceBrush" Color="#141414"/>
    <SolidColorBrush x:Key="OperatorInputBrush" Color="#050505"/>
    <SolidColorBrush x:Key="OperatorTextBrush" Color="#F4F7FB"/>
    <SolidColorBrush x:Key="OperatorBorderBrush" Color="#383838"/>

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource OperatorTextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource OperatorSurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource OperatorBorderBrush}"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" local:ThemeManager.SkipTheme="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource OperatorTextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource OperatorInputBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource OperatorBorderBrush}"/>
      <Setter Property="Padding" Value="9"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="CaretBrush" Value="{DynamicResource OperatorTextBrush}"/>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource OperatorTextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource OperatorInputBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource OperatorBorderBrush}"/>
      <Setter Property="Padding" Value="6"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" local:ThemeManager.SkipTheme="True"/>
              <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" Background="Transparent" BorderThickness="0"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="ContentSite" Margin="10,4,32,4" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
              <!-- Editable combos (the media tag box) type into this; without it the text is invisible. -->
              <TextBox x:Name="PART_EditableTextBox" Margin="8,2,28,2" Padding="0" VerticalAlignment="Center"
                       Background="{TemplateBinding Background}" BorderThickness="0" FontSize="12"
                       Foreground="{TemplateBinding Foreground}" CaretBrush="{TemplateBinding Foreground}"
                       Visibility="Collapsed" IsReadOnly="{TemplateBinding IsReadOnly}"/>
              <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"
                    Fill="{TemplateBinding Foreground}" Data="M 0 0 L 4 4 L 8 0 Z"/>
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" MinWidth="{TemplateBinding ActualWidth}" local:ThemeManager.SkipTheme="True">
                  <ScrollViewer MaxHeight="300" CanContentScroll="True">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEditable" Value="True">
                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource OperatorTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource OperatorPanelBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
            <!-- Without a template the rows are drawn by the system's own item chrome: a white
                 hover and a blue selection inside an otherwise dark drop-down, which is what made
                 the makers' pickers look like they belonged to another app. -->
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                  <Border x:Name="Row" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                          Margin="2,1" CornerRadius="5" BorderThickness="0" local:ThemeManager.SkipTheme="True">
                    <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True">
                      <Setter TargetName="Row" Property="Background" Value="#2B3949"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Row" Property="Background" Value="#1E2A36"/>
                      <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                      <Setter TargetName="Row" Property="BorderThickness" Value="3,0,0,0"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource OperatorTextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource OperatorSurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource OperatorBorderBrush}"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" local:ThemeManager.SkipTheme="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#0B6B50"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#14A67C"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource OperatorTextBrush}"/>
      <Setter Property="Margin" Value="4"/>
    </Style>
  </Application.Resources>
</Application>
