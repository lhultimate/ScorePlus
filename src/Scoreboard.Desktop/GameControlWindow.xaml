<Window x:Class="Scoreboard.Desktop.GameControlWindow" Icon="app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Scoreboard.Desktop"
        Title="ScorePlus — Control Panel" Width="1520" Height="980" MinWidth="1040" MinHeight="760"
        Background="#0E1218" Foreground="#F4F7FB" FontFamily="Segoe UI">
  <Window.Resources>
    <Style x:Key="RailCard" TargetType="Border">
      <Setter Property="Background" Value="#171C25"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="RailTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#93A0B2"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="RailAccent" TargetType="Border">
      <Setter Property="Width" Value="3"/>
      <Setter Property="Height" Value="12"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="Background" Value="#38D7A3"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
    <Style x:Key="SplitterStyle" TargetType="GridSplitter">
      <Setter Property="Background" Value="#1E2630"/>
      <Setter Property="ShowsPreview" Value="True"/>
    </Style>
    <Style x:Key="TabButton" TargetType="Button">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="18,9"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Background" Value="#141A23"/>
      <Setter Property="BorderBrush" Value="#28323F"/>
      <Setter Property="Foreground" Value="#93A0B2"/>
    </Style>
  </Window.Resources>

  <DockPanel>
    <StatusBar DockPanel.Dock="Bottom" Background="#171C25" Foreground="#93A0B2">
      <StatusBarItem><TextBlock x:Name="MediaStatus" Text="READY · detached panel" TextTrimming="CharacterEllipsis"/></StatusBarItem>
      <Separator/>
      <StatusBarItem><TextBlock x:Name="AutosaveText" Text="SHARED SESSION"/></StatusBarItem>
    </StatusBar>

    <Grid Margin="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="PreviewColumn" Width="336" MinWidth="260"/>
        <ColumnDefinition x:Name="SplitterColumn" Width="7"/>
        <ColumnDefinition Width="*" MinWidth="620"/>
      </Grid.ColumnDefinitions>

      <!-- The same program rail as the main window: preview, quick actions, level and audience. -->
      <Border x:Name="PreviewRail" Grid.Column="0" Style="{StaticResource RailCard}" Margin="0,0,6,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <DockPanel Margin="0,0,0,6">
            <TextBlock x:Name="PreviewAudienceHint" DockPanel.Dock="Right" Text="AUDIENCE" Foreground="#38D7A3"
                       FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource RailAccent}"/>
              <TextBlock Text="PROGRAM PREVIEW" Style="{StaticResource RailTitle}"/>
            </StackPanel>
          </DockPanel>

          <DockPanel Grid.Row="1" Margin="0,0,0,5">
            <TextBlock Text="DISPLAY" DockPanel.Dock="Left" Foreground="#5C6B7E" FontSize="10" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="DisplaySelector" FontSize="11" MinHeight="28" SelectionChanged="Display_Changed"
                      ToolTip="Choose the display this panel previews and publishes"/>
          </DockPanel>

          <DockPanel Grid.Row="2" Margin="0,0,0,5">
            <Button x:Name="LayoutPrevButton" DockPanel.Dock="Left" Content="◀" Padding="0" Width="34" MinHeight="30"
                    FontSize="12" Click="LayoutPrev_Click" ToolTip="Previous layout on this display"/>
            <Button x:Name="LayoutNextButton" DockPanel.Dock="Right" Content="▶" Padding="0" Width="34" MinHeight="30"
                    FontSize="12" Click="LayoutNext_Click" ToolTip="Next layout on this display"/>
            <TextBlock x:Name="PreviewLayoutLabel" Text="1 · Broadcast Classic" FontSize="11" FontWeight="SemiBold"
                       TextAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0"/>
          </DockPanel>

          <ContentControl x:Name="PreviewHost" Grid.Row="3" VerticalAlignment="Top"/>

          <StackPanel Grid.Row="4" Margin="0,8,0,0">
            <ContentControl x:Name="QuickMediaHost"/>
            <ContentControl x:Name="QuickLayoutsHost"/>
          </StackPanel>

          <Border Grid.Row="5" Background="#171C25" CornerRadius="9" Padding="10,8" Margin="0,8,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <DockPanel>
                  <TextBlock x:Name="SoundLevelText" DockPanel.Dock="Right" Text="—" Foreground="#93A0B2"
                             FontSize="10" FontWeight="Bold" Margin="6,0,0,0"/>
                  <TextBlock Text="SOUND LEVEL" Foreground="#5C6B7E" FontSize="10" FontWeight="Bold"/>
                </DockPanel>
                <UniformGrid x:Name="SoundMeterSegments" Columns="22" Height="14" Margin="0,5,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="132">
                <TextBlock x:Name="OnAirInfo" Text="STANDBY" Foreground="#38D7A3" FontSize="10" FontWeight="Bold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ShowInfo" Text="—" Foreground="#93A0B2" FontSize="10" Margin="0,3,0,0"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Row="6" Background="#171C25" CornerRadius="9" Padding="10,8" Margin="0,8,0,0" Height="190">
            <ContentControl x:Name="AudienceHost"/>
          </Border>
        </Grid>
      </Border>

      <GridSplitter x:Name="PreviewSplitter" Grid.Column="1" Style="{StaticResource SplitterStyle}" Width="7"
                    HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"/>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="ControlTab" Style="{StaticResource TabButton}" Content="CONTROL PANEL" Click="ControlTab_Click"/>
          <Button x:Name="MediaTab" Style="{StaticResource TabButton}" Content="MEDIA" Click="MediaTab_Click"
                  ToolTip="Clips, camera, replay and playlists"/>
          <Button x:Name="RosterTab" Style="{StaticResource TabButton}" Content="ROSTERS" Click="RosterTab_Click"
                  ToolTip="Team rosters, player stats and the player on the graphic"/>
          <Button x:Name="MacrosTab" Style="{StaticResource TabButton}" Content="MACROS" Click="MacrosTab_Click"
                  ToolTip="One button that changes several things in order, and plays media or roster stats"/>
        </StackPanel>
        <Grid Grid.Row="1">
          <ContentControl x:Name="PanelHost"/>
          <local:MediaDock x:Name="MediaControl" Visibility="Collapsed"/>
          <local:RosterDock x:Name="RosterControl" Visibility="Collapsed"/>
          <ContentControl x:Name="MacroHost" Visibility="Collapsed"/>
        </Grid>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
