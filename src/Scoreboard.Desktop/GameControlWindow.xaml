<Window x:Class="Scoreboard.Desktop.GameControlWindow" Icon="app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Scoreboard.Desktop"
        Title="ScorePlus — Control Panel" Width="1360" Height="985" MinWidth="1040" MinHeight="915"
        Background="#0B0F14" Foreground="#F4F7FB" FontFamily="Segoe UI">
  <Window.Resources>
    <Style x:Key="TabButton" TargetType="Button">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="18,9"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Background" Value="#141A23"/>
      <Setter Property="BorderBrush" Value="#28323F"/>
      <Setter Property="Foreground" Value="#93A0B2"/>
    </Style>
    <Style x:Key="SmallButton" TargetType="Button">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="MinWidth" Value="32"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Margin" Value="2"/>
    </Style>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#111721" Padding="14,9">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Undo" Tag="global.undo" Click="Undo_Click" ToolTip="Undo the last action"/>
          <Button Content="Keybinds…" Click="Keybinds_Click" ToolTip="Assign a key combination to any button on this panel"/>
          <Button Content="New panel" Click="NewPanel_Click" ToolTip="Open another control panel that stays in sync"/>
        </StackPanel>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="SCOREPLUS · CONTROL PANEL" FontSize="14" FontWeight="Bold"/>
          <TextBlock Text="This window has its own display and layout choice. The game, the media library and the audience follow whatever you publish." Foreground="#93A0B2" FontSize="11" Margin="0,3,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="#0E141C" Padding="14,6">
      <TextBlock x:Name="MediaStatus" Text="MEDIA READY" Foreground="#93A0B2" FontSize="11" TextTrimming="CharacterEllipsis"/>
    </Border>
    <Grid Margin="12,10,12,10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Program preview: which display this window is driving, and its layout. -->
      <Border x:Name="ProgramStrip" Grid.Row="0" Background="#10161F" CornerRadius="9" Padding="10,8" Margin="0,0,0,9">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="248"/>
          </Grid.ColumnDefinitions>
          <Border Background="#091018" CornerRadius="7" ClipToBounds="True" Height="140">
            <ContentControl x:Name="PreviewHost"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="12,2,0,0">
            <StackPanel Orientation="Horizontal">
              <Border Width="3" Height="12" CornerRadius="2" Background="#38D7A3" Margin="0,0,6,0"/>
              <TextBlock Text="PROGRAM PREVIEW" FontSize="11" FontWeight="Bold" Foreground="#93A0B2" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="DISPLAY" FontSize="10" FontWeight="Bold" Foreground="#5C6B7E" Margin="0,8,0,3"/>
            <ComboBox x:Name="DisplaySelector" FontSize="12" MinHeight="30" SelectionChanged="Display_Changed"
                      ToolTip="Choose the display this panel previews and publishes"/>
            <DockPanel Margin="0,8,0,0">
              <Button x:Name="LayoutPrevButton" DockPanel.Dock="Left" Style="{StaticResource SmallButton}" Content="◀" Click="LayoutPrev_Click" ToolTip="Previous layout on this display"/>
              <Button x:Name="LayoutNextButton" DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="▶" Click="LayoutNext_Click" ToolTip="Next layout on this display"/>
              <TextBlock x:Name="PreviewLayoutLabel" Text="1 · Broadcast Classic" FontSize="12" FontWeight="SemiBold"
                         TextAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0"/>
            </DockPanel>
            <TextBlock x:Name="ProgramHint" Text="Switching layouts only changes this preview — Update Output puts it on air."
                       FontSize="10" Foreground="#5C6B7E" TextWrapping="Wrap" Margin="0,6,0,0"/>
          </StackPanel>
          <!-- What the audience is watching right now, independent of this panel's choices. -->
          <Border Grid.Column="2" Background="#091018" CornerRadius="7" ClipToBounds="True" Padding="8,6" Margin="12,0,0,0">
            <ContentControl x:Name="AudienceHost"/>
          </Border>
        </Grid>
      </Border>

      <!-- The same quick-media and quick-layout buttons as the main rail, so a detached panel can
           cue media or reach a layout on any display without a trip back to the main window. -->
      <StackPanel Grid.Row="1">
        <ContentControl x:Name="QuickMediaHost"/>
        <ContentControl x:Name="QuickLayoutsHost"/>
      </StackPanel>

      <!-- The same peak meter and show line as the main rail, so a panel on a second monitor can
           see the output level without turning back to the main window. -->
      <local:SoundMeterView x:Name="Meter" Grid.Row="2"/>

      <StackPanel Grid.Row="3" Orientation="Horizontal">
        <Button x:Name="ControlTab" Style="{StaticResource TabButton}" Content="CONTROL PANEL" Click="ControlTab_Click"/>
        <Button x:Name="MediaTab" Style="{StaticResource TabButton}" Content="MEDIA" Click="MediaTab_Click" ToolTip="Clips, camera, replay and playlists"/>
        <Button x:Name="RosterTab" Style="{StaticResource TabButton}" Content="ROSTERS" Click="RosterTab_Click"
                ToolTip="Team rosters, player stats and the player on the graphic"/>
      </StackPanel>

      <Grid Grid.Row="4" Margin="0,9,0,0">
        <ContentControl x:Name="PanelHost"/>
        <local:MediaDock x:Name="MediaControl" Visibility="Collapsed"/>
        <local:RosterDock x:Name="RosterControl" Visibility="Collapsed"/>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
