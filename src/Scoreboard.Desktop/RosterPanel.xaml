<UserControl x:Class="Scoreboard.Desktop.RosterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" FontSize="12" Background="Transparent">
  <UserControl.Resources>
    <Style x:Key="FieldBox" TargetType="TextBox">
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Background" Value="{DynamicResource RosterInputBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RosterTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RosterBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CaretBrush" Value="{DynamicResource RosterTextBrush}"/>
    </Style>
    <!-- BasedOn the app's ComboBox: without it the explicit style discards the custom template and
         the popup falls back to a white system list with this desk's light text on it. -->
    <Style x:Key="FieldCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="Background" Value="{DynamicResource RosterInputBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RosterTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RosterBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <!-- The drop-down list belongs to the desk, so it uses the desk's own wells and text. -->
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource RosterTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource RosterSurfaceBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Style.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource RosterSurfaceAltBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource RosterInputBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource RosterMutedBrush}"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>
    <Style x:Key="SmallButton" TargetType="Button">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="Background" Value="{DynamicResource RosterSurfaceAltBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RosterTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RosterBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Padding" Value="14,5"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="Background" Value="{DynamicResource RosterAccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RosterAccentTextBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Width" Value="30"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Margin" Value="4,0,0,0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="{DynamicResource RosterSurfaceAltBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RosterMutedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RosterBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="PlayerRow" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1*" MinWidth="240"/>
      <ColumnDefinition Width="12"/>
      <ColumnDefinition Width="1.15*" MinWidth="280"/>
    </Grid.ColumnDefinitions>

    <!-- ============ the roster: pick, search, browse ============ -->
    <Border Background="{DynamicResource RosterSurfaceBrush}" CornerRadius="8" ClipToBounds="True">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="12,12,12,10">
          <!-- The roster picker: captioned, summarised and stepped in, so nobody has to guess
               which team's players the desk is showing or how to change it. -->
          <TextBlock Text="ROSTER — PICK ONE FROM THIS LIST" FontSize="10" FontWeight="Bold" Margin="2,0,0,4"
                     Foreground="{DynamicResource RosterMutedBrush}"/>
          <DockPanel>
            <Button x:Name="DeleteRosterButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="🗑"
                    Click="DeleteRoster_Click" ToolTip="Delete this roster from the library"/>
            <Button x:Name="RenameRosterButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="✎"
                    Click="RenameRoster_Click" ToolTip="Rename this roster"/>
            <!-- An explicit item template (not DisplayMemberPath): the closed box in this
                 template prints the item itself, which showed the type name. -->
            <ComboBox x:Name="RosterBox" Style="{StaticResource FieldCombo}"
                      SelectionChanged="Roster_Changed"
                      ToolTip="Pick another roster from the library — the desk and this team's graphic follow it">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" Foreground="{DynamicResource RosterTextBrush}" TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </DockPanel>
          <TextBlock x:Name="RosterSummary" FontSize="10" Margin="2,6,0,0" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource RosterMutedBrush}"/>
          <Grid Margin="0,8,0,0">
            <TextBox x:Name="SearchInput" Style="{StaticResource FieldBox}" Padding="30,4,8,4" TextChanged="Search_Changed"
                     ToolTip="Search this roster by name, number or position"/>
            <TextBlock Text="🔍" IsHitTestVisible="False" FontSize="12" VerticalAlignment="Center"
                       HorizontalAlignment="Left" Margin="10,0,0,0" Foreground="{DynamicResource RosterMutedBrush}"/>
          </Grid>
          <TextBlock FontSize="10" TextWrapping="Wrap" Margin="2,8,2,0"
                     Foreground="{DynamicResource RosterMutedBrush}"
                     Text="Import or export a roster (.spr) or one player (.spp) from the buttons at the top of the tab."/>
        </StackPanel>

        <Border DockPanel.Dock="Top" Background="{DynamicResource RosterSurfaceAltBrush}" Padding="12,8">
          <DockPanel>
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" Text="0 players" FontSize="11"
                       Foreground="{DynamicResource RosterMutedBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="ALL PLAYERS" FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource RosterMutedBrush}" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource RosterSurfaceAltBrush}" Padding="10">
          <DockPanel>
            <Button x:Name="SelectButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                    Content="Select player" Click="Select_Click"
                    ToolTip="Make this the player the scorebug's selected-player elements show"/>
            <Button x:Name="GroupPlayerButton" DockPanel.Dock="Right" Style="{StaticResource SmallButton}"
                    Content="Group…" Click="GroupPlayer_Click"
                    ToolTip="Give this player a squad group — names in the same group share a foldable section"/>
            <Button x:Name="RemovePlayerButton" DockPanel.Dock="Right" Style="{StaticResource SmallButton}"
                    Content="Remove" Click="RemovePlayer_Click"/>
            <Button x:Name="AddPlayerButton" Style="{StaticResource SmallButton}" Margin="0"
                    Content="Add player" Click="AddPlayer_Click"/>
          </DockPanel>
        </Border>

        <!-- Grouped player list: one headed section per squad group, each header folding the
             players under it. A real ListBox, so keyboard and programmatic selection both drive
             the editor just like a click does. -->
        <ListBox x:Name="PlayerList" Background="Transparent" BorderThickness="0"
                 SelectionMode="Single" SelectionChanged="PlayerList_SelectionChanged"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Margin" Value="0"/>
              <Setter Property="BorderThickness" Value="0"/>
              <Setter Property="Background" Value="Transparent"/>
              <!-- The rows draw their own highlight; the only selection cue is the underlined
                   name of the player currently in the editor. -->
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter HorizontalAlignment="Stretch"/>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ============ the player: details on the right, stats underneath ============ -->
    <Border Grid.Column="2" Background="{DynamicResource RosterSurfaceBrush}" CornerRadius="8" Padding="16,14">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
          <DockPanel>
            <TextBlock x:Name="OnAirLabel" DockPanel.Dock="Right" Text="NO PLAYER SELECTED" FontSize="10" FontWeight="Bold"
                       Foreground="{DynamicResource RosterMutedBrush}" VerticalAlignment="Center"
                       ToolTip="The player the scorebug's selected-player bindings read"/>
            <!-- Puts nobody on the graphic for this side, so a player element prints nothing. -->
            <Button x:Name="ClearPlayerButton" DockPanel.Dock="Right" Style="{StaticResource SmallButton}"
                    Content="No player" Margin="0,0,10,0" Click="ClearPlayer_Click"
                    ToolTip="Take the player off the graphic for this side — the choice sticks until you select somebody"/>
            <TextBlock Text="PLAYER" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource RosterMutedBrush}"/>
            <TextBlock x:Name="PlayerInfoText" FontSize="10" Margin="8,0,0,0"
                       Foreground="{DynamicResource RosterMutedBrush}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
          </DockPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <!-- A portrait uploaded here travels with the selected player into the studio. -->
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Width="104" Height="124" CornerRadius="7" BorderThickness="1"
                      Background="{DynamicResource RosterSurfaceAltBrush}"
                      BorderBrush="{DynamicResource RosterBorderBrush}" Padding="4">
                <Grid>
                  <Image x:Name="PlayerPhotoImage" Stretch="Uniform"/>
                  <TextBlock x:Name="PlayerPhotoEmpty" Text="NO PHOTO" FontSize="10" FontWeight="Bold"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="{DynamicResource RosterMutedBrush}"/>
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock Text="PLAYER PHOTO" FontSize="10" FontWeight="Bold"
                           Foreground="{DynamicResource RosterMutedBrush}"/>
                <Button x:Name="ChoosePhotoButton" Style="{StaticResource SmallButton}" Content="Upload photo…"
                        Margin="0,6,0,0" Click="ChoosePhoto_Click"
                        ToolTip="Choose a portrait for this player; it is copied into ScorePlus"/>
                <Button x:Name="RemovePhotoButton" Style="{StaticResource SmallButton}" Content="Remove photo"
                        Margin="0,4,0,0" Click="RemovePhoto_Click"/>
                <TextBlock x:Name="PlayerPhotoNameText" FontSize="10" TextTrimming="CharacterEllipsis"
                           Margin="0,5,0,0" Foreground="{DynamicResource RosterMutedBrush}"/>
              </StackPanel>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Text="Number:" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="NumberInput" Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,2,0,6"
                       LostKeyboardFocus="Player_LostFocus" KeyDown="Player_KeyDown" ToolTip="Jersey number"/>
              <TextBlock Grid.Row="1" Text="Name:" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="NameInput" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,2,0,6"
                       LostKeyboardFocus="Player_LostFocus" KeyDown="Player_KeyDown"/>
              <TextBlock Grid.Row="2" Text="Position:" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="PositionInput" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,2,0,6"
                       LostKeyboardFocus="Player_LostFocus" KeyDown="Player_KeyDown"/>
              <TextBlock Grid.Row="3" Text="Group:" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="GroupInput" Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,2,0,0"
                       LostKeyboardFocus="Player_LostFocus" KeyDown="Player_KeyDown"
                       ToolTip="Put this player in a squad group — Defence, Bench, U12. Players in the same group share a foldable section in the list."/>
            </Grid>

            <Border Height="1" Background="{DynamicResource RosterBorderBrush}" Margin="0,14,0,12"/>

            <DockPanel>
              <TextBlock x:Name="StatsCountText" DockPanel.Dock="Right" FontSize="11"
                         Foreground="{DynamicResource RosterMutedBrush}" VerticalAlignment="Center"/>
              <TextBlock x:Name="StatsTitle" Text="STATS" FontSize="11" FontWeight="Bold"
                         Foreground="{DynamicResource RosterMutedBrush}"/>
            </DockPanel>
            <!-- Two columns, so a sport's twenty-odd stat columns fit the desk without scrolling. -->
            <UniformGrid x:Name="StatsHost" Columns="2" Margin="0,8,0,0" VerticalAlignment="Top"/>
            <TextBlock Text="ADD A STAT COLUMN" FontSize="10" FontWeight="Bold" Margin="0,12,0,2"
                       Foreground="{DynamicResource RosterMutedBrush}"/>
            <DockPanel Margin="0,2,0,0">
              <Button x:Name="AddStatButton" DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Add column"
                      Click="AddStat_Click" ToolTip="Give every player on this roster this stat column"/>
              <ComboBox x:Name="StatPresetBox" Style="{StaticResource FieldCombo}" IsEditable="True"
                        ToolTip="Pick one of the team's stats, or type any name for a new column"/>
            </DockPanel>
            <TextBlock x:Name="HintText" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"
                       Foreground="{DynamicResource RosterMutedBrush}"
                       Text="The boxes under STATS hold this player's values. Picking a name here (or typing a new one) adds that column to every player on the roster, so nobody has to name stats before entering them. A stat can use team colors, font, transitions and animations on the graphic."/>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
