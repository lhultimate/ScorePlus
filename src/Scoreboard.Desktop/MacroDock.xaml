<UserControl x:Class="Scoreboard.Desktop.MacroDock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" Foreground="{DynamicResource MacroTextBrush}"
             PreviewMouseMove="MacroDock_PreviewMouseMove"
             PreviewMouseLeftButtonUp="MacroDock_PreviewMouseLeftButtonUp">
  <UserControl.Resources>
    <!-- Dark fallbacks; MacroDock.ApplyTheme replaces these with the selected theme's shades. -->
    <SolidColorBrush x:Key="MacroPanelBrush" Color="#080808"/>
    <SolidColorBrush x:Key="MacroSurfaceBrush" Color="#141414"/>
    <SolidColorBrush x:Key="MacroInputBrush" Color="#050505"/>
    <SolidColorBrush x:Key="MacroTextBrush" Color="#F4F7FB"/>
    <SolidColorBrush x:Key="MacroMutedBrush" Color="#B0B0B0"/>
    <SolidColorBrush x:Key="MacroBorderBrush" Color="#383838"/>
    <SolidColorBrush x:Key="MacroAccentBrush" Color="#38D7A3"/>
    <SolidColorBrush x:Key="MacroAccentSoftBrush" Color="#123C33"/>
    <SolidColorBrush x:Key="MacroAccentTextBrush" Color="#F4F7FB"/>
    <SolidColorBrush x:Key="MacroHoverBrush" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="MacroSelectionBrush" Color="#123C33"/>
    <SolidColorBrush x:Key="MacroSelectionTextBrush" Color="#F4F7FB"/>

    <Style x:Key="MacroAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Background" Value="{DynamicResource MacroSurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource MacroBorderBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource MacroTextBrush}"/>
    </Style>
    <Style x:Key="MacroAccent" TargetType="Button" BasedOn="{StaticResource MacroAction}">
      <Setter Property="Background" Value="{DynamicResource MacroAccentSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource MacroAccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource MacroAccentTextBrush}"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="MacroBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Background" Value="{DynamicResource MacroInputBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource MacroTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource MacroBorderBrush}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource MacroTextBrush}"/>
    </Style>
    <!-- BasedOn is essential here: without it the explicit style discarded the application's
         ComboBox template and item container style, leaving the native white drop-down behind. -->
    <Style x:Key="MacroCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Background" Value="{DynamicResource MacroInputBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource MacroTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource MacroBorderBrush}"/>
    </Style>
    <Style x:Key="MacroLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource MacroMutedBrush}"/>
      <Setter Property="Margin" Value="0,7,0,3"/>
    </Style>
    <Style x:Key="MacroHint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="{DynamicResource MacroMutedBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="MacroListItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource MacroTextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource MacroSurfaceBrush}"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Row" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                    CornerRadius="4" BorderThickness="0">
              <ContentPresenter VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource MacroHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource MacroSelectionBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource MacroSelectionTextBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="8"/>
      <ColumnDefinition Width="358"/>
    </Grid.ColumnDefinitions>

    <DockPanel Grid.Column="0" Margin="0,0,4,0">
      <StackPanel DockPanel.Dock="Top">
        <DockPanel Margin="0,0,0,4">
          <Button DockPanel.Dock="Right" Style="{StaticResource MacroAccent}" Content="+ New macro"
                  Click="NewMacro_Click"/>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="3" Height="13" CornerRadius="2" Background="{DynamicResource MacroAccentBrush}" Margin="0,0,7,0"/>
            <TextBlock Text="MACROS" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource MacroMutedBrush}" VerticalAlignment="Center"/>
          </StackPanel>
        </DockPanel>
        <TextBlock Style="{StaticResource MacroHint}" Text="One button, several changes, in order. Each press runs the full step list against the current game; Update Output then puts the result on air. Media steps start playing immediately."
                   Margin="0,0,0,9"/>
      </StackPanel>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
          <WrapPanel x:Name="MacroButtons" Margin="0,0,0,8" Background="Transparent"/>
          <TextBlock x:Name="EmptyText" Style="{StaticResource MacroHint}" Margin="2,4,8,0"
                     Text="No macros yet. Choose New macro, add a few steps, then press the macro card to run them together."/>
        </Grid>
      </ScrollViewer>
    </DockPanel>

    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                  Background="{DynamicResource MacroBorderBrush}" ShowsPreview="True" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

    <Border Grid.Column="2" Background="{DynamicResource MacroPanelBrush}" CornerRadius="9" Padding="12,10">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <DockPanel Margin="0,0,0,9">
            <Border DockPanel.Dock="Right" Margin="14,0,0,0" Padding="8,2" CornerRadius="8"
                    Background="{DynamicResource MacroSurfaceBrush}" BorderBrush="{DynamicResource MacroBorderBrush}" BorderThickness="1">
              <TextBlock x:Name="EditStatus" Text="" FontSize="9" FontWeight="Bold"
                         Foreground="{DynamicResource MacroAccentBrush}" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="EDIT MACRO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MacroMutedBrush}" VerticalAlignment="Center"/>
          </DockPanel>
          <TextBlock Text="BUTTON LABEL" Style="{StaticResource MacroLabel}" Margin="0,0,0,3"/>
          <TextBox x:Name="NameBox" Style="{StaticResource MacroBox}" TextChanged="Name_Changed"
                   ToolTip="The text on the macro card"/>
          <TextBlock Text="BUTTON COLOR" Style="{StaticResource MacroLabel}" Margin="0,8,0,3"/>
          <DockPanel>
            <Border x:Name="ColorPreview" DockPanel.Dock="Left" Width="32" Height="32"
                    CornerRadius="5" BorderBrush="{DynamicResource MacroBorderBrush}" BorderThickness="1"/>
            <TextBox x:Name="ColorBox" Style="{StaticResource MacroBox}" Margin="7,0,0,0"
                     TextChanged="Color_Changed" LostFocus="Color_LostFocus"
                     ToolTip="A colour code such as #FF6B6B, or choose a swatch below"/>
          </DockPanel>
          <WrapPanel x:Name="ColorChoices" Margin="0,4,0,0"/>
          <TextBlock Style="{StaticResource MacroHint}" Margin="0,2,0,0"
                     Text="Optional colour coding for the macro button. Leave it empty for the theme accent."/>
          <WrapPanel Margin="0,7,0,0">
            <Button x:Name="SaveButton" Style="{StaticResource MacroAccent}" Content="Save macro" Click="Save_Click"/>
            <Button x:Name="DeleteButton" Style="{StaticResource MacroAction}" Content="Delete" Click="Delete_Click"/>
          </WrapPanel>

          <TextBlock Text="STEPS · RUN TOP TO BOTTOM" Style="{StaticResource MacroLabel}"/>
          <ListBox x:Name="StepList" Height="150" Background="{DynamicResource MacroInputBrush}"
                   BorderBrush="{DynamicResource MacroBorderBrush}" Foreground="{DynamicResource MacroTextBrush}"
                   FontSize="11" ItemContainerStyle="{StaticResource MacroListItem}"
                   SelectionChanged="Step_Selected">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <WrapPanel Margin="0,5,0,0">
            <Button Style="{StaticResource MacroAction}" Content="↑ Up" Click="StepUp_Click"/>
            <Button Style="{StaticResource MacroAction}" Content="↓ Down" Click="StepDown_Click"/>
            <Button Style="{StaticResource MacroAction}" Content="Remove step" Click="StepRemove_Click"/>
          </WrapPanel>

          <Border Height="1" Background="{DynamicResource MacroBorderBrush}" Margin="0,10,0,2"/>
          <TextBlock Text="ADD A STEP" Style="{StaticResource MacroLabel}"/>
          <ComboBox x:Name="KindBox" Style="{StaticResource MacroCombo}" SelectionChanged="Kind_Changed"/>

          <StackPanel x:Name="CommandPanel">
            <TextBlock Text="CONSOLE BUTTON" Style="{StaticResource MacroLabel}"/>
            <ComboBox x:Name="CommandBox" Style="{StaticResource MacroCombo}"/>
            <TextBlock Style="{StaticResource MacroHint}" Margin="0,3,0,0"
                       Text="Runs the same action as that button on the console. Set-value dialogs are left out so a macro never stops for a window."/>
          </StackPanel>
          <StackPanel x:Name="SportValuePanel">
            <TextBlock Text="SPORT VALUE" Style="{StaticResource MacroLabel}"/>
            <ComboBox x:Name="SportValueBox" Style="{StaticResource MacroCombo}"/>
            <CheckBox x:Name="SportDeltaBox" Content="Add to the current value instead of replacing it"
                      Foreground="{DynamicResource MacroMutedBrush}" FontSize="10" Margin="0,6,0,0"/>
          </StackPanel>
          <StackPanel x:Name="CustomValuePanel">
            <TextBlock Text="CUSTOM VALUE" Style="{StaticResource MacroLabel}"/>
            <ComboBox x:Name="CustomValueBox" Style="{StaticResource MacroCombo}"/>
            <CheckBox x:Name="CustomDeltaBox" Content="Add to the current value instead of replacing it"
                      Foreground="{DynamicResource MacroMutedBrush}" FontSize="10" Margin="0,6,0,0"/>
          </StackPanel>
          <StackPanel x:Name="SidePanel">
            <TextBlock Text="SIDE" Style="{StaticResource MacroLabel}"/>
            <ComboBox x:Name="SideBox" Style="{StaticResource MacroCombo}" SelectionChanged="Side_Changed"/>
          </StackPanel>
          <StackPanel x:Name="AmountPanel">
            <TextBlock Text="POINTS TO ADD (CAN BE NEGATIVE)" Style="{StaticResource MacroLabel}"/>
            <TextBox x:Name="AmountBox" Style="{StaticResource MacroBox}" Text="1"/>
          </StackPanel>
          <StackPanel x:Name="ValuePanel">
            <TextBlock x:Name="ValueLabel" Text="VALUE" Style="{StaticResource MacroLabel}"/>
            <TextBox x:Name="ValueBox" Style="{StaticResource MacroBox}" Text="0"/>
          </StackPanel>
          <StackPanel x:Name="RosterPanel">
            <TextBlock Text="PLAYER" Style="{StaticResource MacroLabel}"/>
            <ComboBox x:Name="PlayerBox" Style="{StaticResource MacroCombo}"/>
            <TextBlock Text="STAT" Style="{StaticResource MacroLabel}"/>
            <ComboBox x:Name="StatBox" Style="{StaticResource MacroCombo}" IsEditable="True"/>
            <CheckBox x:Name="DeltaBox" Content="Add to the current value instead of replacing it"
                      Foreground="{DynamicResource MacroMutedBrush}" FontSize="10" Margin="0,6,0,0"/>
          </StackPanel>
          <StackPanel x:Name="VideoPanel">
            <TextBlock Text="VIDEO FILE" Style="{StaticResource MacroLabel}"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="VideoPathBox" Style="{StaticResource MacroBox}" Margin="0,0,5,0"/>
              <Button Grid.Column="1" Style="{StaticResource MacroAction}" Content="Browse…" Margin="0" Click="BrowseVideo_Click"/>
            </Grid>
          </StackPanel>

          <WrapPanel Margin="0,9,0,0">
            <Button x:Name="AddStepButton" Style="{StaticResource MacroAccent}" Content="+ Add step" Click="AddStep_Click" Margin="0,0,6,0"/>
            <Button x:Name="UpdateStepButton" Style="{StaticResource MacroAction}" Content="Update selected" Click="UpdateStep_Click" Margin="0"/>
          </WrapPanel>
          <TextBlock Style="{StaticResource MacroHint}" Margin="0,8,0,0"
                     Text="A macro starts from step 1 every time. Score, down, timeouts, clocks, period, video, roster stats, custom values, console buttons and any sport value can be mixed freely; a step that needs a missing player or clip is skipped and the rest still run."/>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
