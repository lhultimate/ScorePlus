<Window x:Class="Scoreboard.Desktop.ScorebugEditorWindow" Icon="app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Scoreboard.Desktop"
        Title="ScorePlus — Display Studio" Width="1360" Height="900" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterOwner" Background="#0E1218" Foreground="#F4F7FB" FontFamily="Segoe UI">
  <Window.Resources>
    <local:IconNameConverter x:Key="IconNameConverter"/>
    <Style x:Key="ToolButton" TargetType="Button">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Margin" Value="3,0,0,0"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#93A0B2"/>
      <Setter Property="Margin" Value="10,12,10,4"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="#7C8A9C"/>
      <Setter Property="Margin" Value="10,4,0,2"/>
    </Style>
    <Style x:Key="FieldBox" TargetType="TextBox">
      <Setter Property="Margin" Value="10,0,10,2"/>
    </Style>
    <Style x:Key="LayerRow" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="8,7"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="LayoutButton" TargetType="Button">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Margin" Value="4,0,0,0"/>
    </Style>
  </Window.Resources>

  <Grid Margin="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="252"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="330"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ============ TOOLBAR ============ -->
    <StackPanel Grid.ColumnSpan="3" Margin="2,0,2,10">
      <DockPanel Margin="0,0,0,8">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="TEXT +" Style="{StaticResource ToolButton}" FontWeight="SemiBold" Click="AddText_Click"/>
          <Button Content="LOGO +" Style="{StaticResource ToolButton}" FontWeight="SemiBold" Click="AddLogo_Click"/>
          <Button Content="IMAGE +" Style="{StaticResource ToolButton}" FontWeight="SemiBold" Click="AddImage_Click"
                  ToolTip="Import a picture onto the graphic — a sponsor board, a crest, a full-frame image"/>
          <Button Content="SHAPE +" Style="{StaticResource ToolButton}" FontWeight="SemiBold" Click="AddShape_Click"/>
          <Button Content="SPORT DATA +" Style="{StaticResource ToolButton}" FontWeight="SemiBold" Click="AddData_Click"/>
          <Button Content="PLAYER DATA +" Style="{StaticResource ToolButton}" FontWeight="SemiBold" Click="AddPlayerData_Click"
                  ToolTip="A value from the player currently on the graphic, set in the Rosters tab"/>
          <Button Content="VIDEO +" Style="{StaticResource ToolButton}" FontWeight="SemiBold" Click="AddVideo_Click"/>
          <Button Content="HTML +" Style="{StaticResource ToolButton}" FontWeight="SemiBold" Click="AddHtml_Click"
                  ToolTip="A live HTML/CSS widget, drawn by a browser engine on every screen"/>
          <Button Content="PLAYER PHOTO +" Style="{StaticResource ToolButton}" FontWeight="SemiBold" Click="AddPlayerPhoto_Click"
                  ToolTip="A picture element that follows the selected player's uploaded portrait"/>
          <Button Content="LAYOUT +" Style="{StaticResource ToolButton}" FontWeight="SemiBold" Click="AddLayoutFeed_Click"
                  ToolTip="Put another layout inside this one as a resizeable live feed"/>
          <Button Content="PARTS +" Style="{StaticResource ToolButton}" FontWeight="SemiBold" Click="ImportParts_Click"
                  ToolTip="Copy elements from another layout instead of rebuilding them"/>
          <Button x:Name="UndoButton" Content="UNDO" Style="{StaticResource ToolButton}" FontWeight="SemiBold" Click="Undo_Click"
                  IsEnabled="False" ToolTip="Undo the last studio edit (Ctrl+Z)"/>
          <Button x:Name="RedoButton" Content="REDO" Style="{StaticResource ToolButton}" FontWeight="SemiBold" Click="Redo_Click"
                  IsEnabled="False" ToolTip="Redo the last undone edit (Ctrl+Y or Ctrl+Shift+Z)"/>
          <Button Content="REMOVE" Style="{StaticResource ToolButton}" FontWeight="SemiBold" Click="Remove_Click" ToolTip="Delete the selected element"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="SCOREPLUS · DISPLAY STUDIO" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
          <TextBlock x:Name="HeaderHint" Text="   Arrange audience graphics · edits save automatically" Foreground="#93A0B2" VerticalAlignment="Center"/>
        </StackPanel>
      </DockPanel>

      <!-- Displays: one screen each, with its own layouts and its own audience window. -->
      <Border Background="#171C25" CornerRadius="9" Padding="10,7" Margin="0,0,0,6">
        <StackPanel>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="New display…" Style="{StaticResource LayoutButton}" Click="DisplayNew_Click" ToolTip="Add another screen, for example a lower-thirds display"/>
              <Button Content="Import .spd…" Style="{StaticResource LayoutButton}" Click="DisplayImport_Click" ToolTip="Add a whole ScorePlus Display file — every layout it holds — to this game"/>
              <Button Content="Export .spd…" Style="{StaticResource LayoutButton}" Click="DisplayExport_Click" ToolTip="Write this display and all its layouts to a ScorePlus Display file"/>
              <Button Content="Rename…" Style="{StaticResource LayoutButton}" Click="DisplayRename_Click"/>
              <Button Content="Delete" Style="{StaticResource LayoutButton}" Click="DisplayDelete_Click" ToolTip="Remove this display and its layouts (the last one cannot be deleted)"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Width="3" Height="12" CornerRadius="2" Background="{DynamicResource Accent}" Margin="0,0,7,0"/>
              <TextBlock Text="DISPLAY" FontSize="11" FontWeight="Bold" Foreground="#93A0B2" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <ComboBox x:Name="DisplayBox" Width="220" SelectionChanged="DisplayBox_Changed" ToolTip="Which screen these layouts belong to"/>
              <TextBlock x:Name="DisplayHintText" Text="  Each display gets its own audience window." Foreground="#5C6B7E" FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
          </DockPanel>
          <!-- How this layout lands on air: dissolve, slide or swing, over 0–5 seconds. -->
          <DockPanel Margin="0,7,0,0">
            <StackPanel Orientation="Horizontal">
              <Border Width="3" Height="12" CornerRadius="2" Background="{DynamicResource Accent}" Margin="0,0,7,0"/>
              <TextBlock Text="TRANSITION IN" FontSize="10" FontWeight="Bold" Foreground="#5C6B7E" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <ComboBox x:Name="TransitionBox" Width="128" FontSize="11" SelectionChanged="Transition_Changed"
                        ToolTip="How this layout arrives on air when it goes to output"/>
              <TextBox x:Name="TransitionSecondsInput" Width="54" FontSize="11" Margin="6,0,0,0" TextChanged="TransitionSeconds_Changed"
                       ToolTip="Seconds this layout's hand-over takes: 0 cuts, 5 is a slow dissolve"/>
              <TextBlock Text="s" FontSize="10" Foreground="#5C6B7E" VerticalAlignment="Center" Margin="2,0,0,0"/>
              <CheckBox x:Name="OnlyChangesInput" Content="Only animate changes" FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0"
                        Checked="OnlyChanges_Changed" Unchecked="OnlyChanges_Changed"
                        ToolTip="Leave unchanged items still: adding one stat window animates only that window, not the whole graphic"/>
              <Button Content="Video…" FontSize="10" Padding="8,3" Margin="8,0,0,0" Click="TransitionVideo_Click"
                      ToolTip="Use a video clip as this layout's hand-over"/>
              <Button x:Name="TransitionVideoClearButton" Content="Clear video" FontSize="10" Padding="8,3" Margin="4,0,0,0"
                      Click="TransitionVideoClear_Click" Visibility="Collapsed"
                      ToolTip="Go back to the preset transition"/>
              <TextBlock x:Name="TransitionVideoCutLabel" Text="CUT AT" FontSize="10" FontWeight="Bold"
                         Foreground="#5C6B7E" VerticalAlignment="Center" Margin="8,0,3,0" Visibility="Collapsed"/>
              <TextBox x:Name="TransitionVideoCutInput" Width="38" Height="24" FontSize="10" Padding="3,1"
                       TextAlignment="Center" VerticalContentAlignment="Center" Margin="0"
                       TextChanged="TransitionVideoCut_Changed" Visibility="Collapsed"
                       ToolTip="Seconds after the video starts before the new layout cuts in; 0 cuts on its first frame"/>
              <TextBlock x:Name="TransitionVideoCutUnit" Text="s" FontSize="10" Foreground="#5C6B7E"
                         VerticalAlignment="Center" Margin="2,0,0,0" Visibility="Collapsed"/>
              <Button x:Name="TransitionKeyButton" Content="Key…" FontSize="10" Padding="8,3" Margin="4,0,0,0"
                      Click="TransitionChromaKey_Click" Visibility="Collapsed"
                      ToolTip="Choose the green or blue backdrop to remove from this hand-over video"/>
              <Button x:Name="TransitionKeyClearButton" Content="Clear key" FontSize="10" Padding="8,3" Margin="4,0,0,0"
                      Click="TransitionChromaKeyClear_Click" Visibility="Collapsed"
                      ToolTip="Leave the hand-over video untouched"/>
              <TextBlock x:Name="TransitionKeyToleranceLabel" Text="Tol" FontSize="10" Foreground="#5C6B7E" VerticalAlignment="Center" Margin="8,0,3,0"/>
              <TextBox x:Name="TransitionKeyToleranceInput" Width="38" FontSize="10" Padding="4,2" Visibility="Collapsed"
                       TextChanged="TransitionChromaTolerance_Changed"
                       ToolTip="How different a pixel may be from the key colour and still disappear (0–1)"/>
              <TextBlock x:Name="TransitionCaption" Text="  Saved with this layout — every layout can arrive differently." Foreground="#5C6B7E" FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
          </DockPanel>
          <!-- Football's two scoring plays can each have their own celebration: a made animation or a keyed video. -->
          <DockPanel Margin="0,7,0,0">
            <StackPanel Orientation="Horizontal">
              <Border Width="3" Height="12" CornerRadius="2" Background="{DynamicResource Accent}" Margin="0,0,7,0"/>
              <TextBlock Text="SCORE ANIMATIONS" FontSize="10" FontWeight="Bold" Foreground="#5C6B7E" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="Touchdown" FontSize="10" Foreground="#93A0B2" VerticalAlignment="Center" Margin="0,0,4,0"/>
              <ComboBox x:Name="TouchdownAnimationBox" Width="145" FontSize="11" SelectionChanged="ScoreAnimation_Changed"
                        ToolTip="Played once when a touchdown is recorded — 6, 7 or 8 points"/>
              <Button x:Name="TouchdownVideoButton" Content="Video…" FontSize="10" Padding="8,3" Margin="6,0,0,0" Click="ScoreVideo_Click"
                      ToolTip="Play a video instead of the animation when a touchdown is recorded"/>
              <TextBlock Text="Field goal" FontSize="10" Foreground="#93A0B2" VerticalAlignment="Center" Margin="12,0,4,0"/>
              <ComboBox x:Name="FieldGoalAnimationBox" Width="145" FontSize="11" SelectionChanged="ScoreAnimation_Changed"
                        ToolTip="Played once when a three-point football score is recorded"/>
              <Button x:Name="FieldGoalVideoButton" Content="Video…" FontSize="10" Padding="8,3" Margin="6,0,0,0" Click="ScoreVideo_Click"
                      ToolTip="Play a video instead of the animation when a field goal is recorded"/>
              <TextBlock x:Name="ScoreAnimationHintText" Text="Choose an animation or video; None leaves it still."
                         Foreground="#5C6B7E" FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
          </DockPanel>
          <!-- Key controls appear only after a score video is chosen, so the normal toolbar stays compact. -->
          <DockPanel x:Name="ScoreVideoKeyRow" Margin="0,5,0,0" Visibility="Collapsed">
            <StackPanel x:Name="TouchdownVideoKeyGroup" Orientation="Horizontal" Visibility="Collapsed">
              <Border Width="3" Height="12" CornerRadius="2" Background="{DynamicResource Accent}" Margin="0,0,7,0"/>
              <TextBlock Text="TD VIDEO" FontSize="10" FontWeight="Bold" Foreground="#5C6B7E" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBlock x:Name="TouchdownVideoCaption" Width="110" Text="No video" FontSize="10" Foreground="#93A0B2"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <Button x:Name="TouchdownVideoKeyButton" Content="Key…" FontSize="10" Padding="8,3" Click="ScoreVideoKey_Click"
                      ToolTip="Choose the green or blue backdrop to remove from the touchdown video"/>
              <Button x:Name="TouchdownVideoKeyClearButton" Content="Clear key" FontSize="10" Padding="8,3" Margin="4,0,0,0" Click="ScoreVideoKeyClear_Click" Visibility="Collapsed"
                      ToolTip="Leave the touchdown video untouched"/>
              <TextBlock x:Name="TouchdownVideoToleranceLabel" Text="Tol" FontSize="10" Foreground="#5C6B7E" VerticalAlignment="Center" Margin="8,0,3,0"/>
              <TextBox x:Name="TouchdownVideoToleranceInput" Width="38" FontSize="10" Padding="4,2"
                       TextChanged="ScoreVideoTolerance_Changed"
                       ToolTip="How different a pixel may be from the key colour and still disappear (0–1)"/>
              <Button x:Name="TouchdownVideoClearButton" Content="Clear video" FontSize="10" Padding="8,3" Margin="4,0,0,0" Click="ScoreVideoClear_Click"
                      ToolTip="Remove the touchdown video and go back to no celebration"/>
            </StackPanel>
            <StackPanel x:Name="FieldGoalVideoKeyGroup" Orientation="Horizontal" Margin="14,0,0,0" Visibility="Collapsed">
              <Border Width="3" Height="12" CornerRadius="2" Background="{DynamicResource Accent}" Margin="0,0,7,0"/>
              <TextBlock Text="FG VIDEO" FontSize="10" FontWeight="Bold" Foreground="#5C6B7E" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBlock x:Name="FieldGoalVideoCaption" Width="110" Text="No video" FontSize="10" Foreground="#93A0B2"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <Button x:Name="FieldGoalVideoKeyButton" Content="Key…" FontSize="10" Padding="8,3" Click="ScoreVideoKey_Click"
                      ToolTip="Choose the green or blue backdrop to remove from the field-goal video"/>
              <Button x:Name="FieldGoalVideoKeyClearButton" Content="Clear key" FontSize="10" Padding="8,3" Margin="4,0,0,0" Click="ScoreVideoKeyClear_Click" Visibility="Collapsed"
                      ToolTip="Leave the field-goal video untouched"/>
              <TextBlock x:Name="FieldGoalVideoToleranceLabel" Text="Tol" FontSize="10" Foreground="#5C6B7E" VerticalAlignment="Center" Margin="8,0,3,0"/>
              <TextBox x:Name="FieldGoalVideoToleranceInput" Width="38" FontSize="10" Padding="4,2"
                       TextChanged="ScoreVideoTolerance_Changed"
                       ToolTip="How different a pixel may be from the key colour and still disappear (0–1)"/>
              <Button x:Name="FieldGoalVideoClearButton" Content="Clear video" FontSize="10" Padding="8,3" Margin="4,0,0,0" Click="ScoreVideoClear_Click"
                      ToolTip="Remove the field-goal video and go back to no celebration"/>
            </StackPanel>
          </DockPanel>
          <DockPanel Margin="0,7,0,0">
            <Button DockPanel.Dock="Right" Content="Clear link" Style="{StaticResource LayoutButton}" Click="LinkClear_Click" ToolTip="Stop this layout, and the layout it links to, from switching the other display"/>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="LINK THIS LAYOUT TO" FontSize="10" FontWeight="Bold" Foreground="#5C6B7E" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <ComboBox x:Name="LinkDisplayBox" Width="140" FontSize="11" SelectionChanged="LinkDisplay_Changed" ToolTip="Another display that should change whenever this layout does"/>
              <ComboBox x:Name="LinkLayoutBox" Width="165" FontSize="11" Margin="6,0,0,0" SelectionChanged="LinkLayout_Changed" ToolTip="The layout that display switches to"/>
              <CheckBox x:Name="LinkBothWaysInput" Content="Both ways" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"
                        Checked="LinkBothWays_Changed" Unchecked="LinkBothWays_Changed"
                        ToolTip="Also switch this layout whenever the other one changes"/>
              <TextBlock x:Name="LinkTipText" Text="  One Update Output can change both screens." Foreground="#5C6B7E" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </Border>

      <!-- Layouts: several scorebugs can live on one display and go to air on Update Output. -->
      <Border Background="#171C25" CornerRadius="9" Padding="10,7">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <Border Width="3" Height="12" CornerRadius="2" Background="{DynamicResource Accent}" Margin="0,0,7,0"/>
            <TextBlock Text="LAYOUT" FontSize="11" FontWeight="Bold" Foreground="#93A0B2" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="LayoutHintText" Foreground="#5C6B7E" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"
                       Text="Pick a layout here — Update Output puts it on air."/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="New layout" Style="{StaticResource LayoutButton}" Click="LayoutNew_Click" ToolTip="Start a blank scorebug layout"/>
            <Button Content="Duplicate" Style="{StaticResource LayoutButton}" Click="LayoutDuplicate_Click" ToolTip="Copy this layout, artwork and all"/>
            <Button Content="Move to…" Style="{StaticResource LayoutButton}" Click="LayoutMove_Click"
                    ToolTip="Move this layout, artwork and all, onto another display"/>
            <Button Content="Copy to…" Style="{StaticResource LayoutButton}" Click="LayoutCopy_Click"
                    ToolTip="Copy this layout onto another display, leaving this one untouched"/>
            <Button Content="Import .spl…" Style="{StaticResource LayoutButton}" Click="LayoutImport_Click" ToolTip="Add a ScorePlus Layout file to this display"/>
            <Button Content="Export .spl…" Style="{StaticResource LayoutButton}" Click="LayoutExport_Click" ToolTip="Write this layout to a ScorePlus Layout file"/>
            <Button Content="Rename…" Style="{StaticResource LayoutButton}" Click="LayoutRename_Click"/>
            <Button Content="Delete" Style="{StaticResource LayoutButton}" Click="LayoutDelete_Click" ToolTip="Remove this layout (the last one cannot be deleted)"/>
          </StackPanel>
          <!-- Every layout on this display as a picture with its name underneath, so switching
               layouts is a click on the one you can see instead of a name in a list. -->
          <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2" Margin="0,7,0,0" MaxHeight="170"
                        HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="LayoutStrip" Orientation="Horizontal"/>
          </ScrollViewer>
        </Grid>
      </Border>
    </StackPanel>

    <!-- ============ LAYERS (top of the list = in front) ============ -->
    <Border Grid.Row="1" Background="#171C25" Margin="0,0,10,0" CornerRadius="9" Padding="8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <DockPanel Margin="2,2,2,6">
            <TextBlock x:Name="LayerCount" DockPanel.Dock="Right" Text="" FontSize="10" Foreground="#5C6B7E" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal">
              <Border Width="3" Height="12" CornerRadius="2" Background="{DynamicResource Accent}" Margin="0,0,6,0"/>
              <TextBlock Text="LAYERS" FontSize="11" FontWeight="Bold" Foreground="#93A0B2" VerticalAlignment="Center"/>
            </StackPanel>
          </DockPanel>
          <TextBlock x:Name="LayersHintText" Text="Front of the picture at the top. Ctrl-click to add rows, Shift-click for a range, Delete to remove them."
                     FontSize="10" Foreground="#5C6B7E" TextWrapping="Wrap" Margin="2,0,2,6"/>
          <UniformGrid Columns="2" Margin="0,0,0,4">
            <Button x:Name="LayerForwardButton" Content="▲ Forward" FontSize="11" Padding="6,6" Margin="0,0,3,0"
                    Click="LayerForward_Click" ToolTip="Move the selected element one step in front"/>
            <Button x:Name="LayerBackwardButton" Content="▼ Backward" FontSize="11" Padding="6,6" Margin="3,0,0,0"
                    Click="LayerBackward_Click" ToolTip="Move the selected element one step behind"/>
          </UniformGrid>
          <UniformGrid Columns="2" Margin="0,0,0,6">
            <Button x:Name="LayerFrontButton" Content="▲ To front" FontSize="11" Padding="6,6" Margin="0,0,3,0"
                    Click="LayerFront_Click" ToolTip="Move the selected element in front of every other element"/>
            <Button x:Name="LayerBackButton" Content="▼ To back" FontSize="11" Padding="6,6" Margin="3,0,0,0"
                    Click="LayerBack_Click" ToolTip="Move the selected element behind every other element"/>
          </UniformGrid>
        </StackPanel>
        <ListBox x:Name="Layers" Background="#10151D" Foreground="White" BorderBrush="#364151"
                 ItemContainerStyle="{StaticResource LayerRow}"
                 SelectionMode="Extended"
                 SelectionChanged="Layers_SelectionChanged"
                 PreviewMouseLeftButtonDown="Layers_MouseDown"
                 PreviewMouseMove="Layers_MouseMove"
                 AllowDrop="True" Drop="Layers_Drop">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="20"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Glyph}" FontSize="12" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding KindLabel}" FontSize="9" Foreground="#5C6B7E" VerticalAlignment="Center" Margin="4,0,0,0"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ============ CANVAS ============ -->
    <Border Grid.Row="1" Grid.Column="1" Background="#171C25" Padding="12" Margin="0,0,10,0" CornerRadius="9">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="4,0,0,10">
          <DockPanel>
            <CheckBox x:Name="CanvasGridInput" Content="Show grid + snap" FontSize="11" FontWeight="SemiBold"
                      Foreground="#38D7A3" VerticalAlignment="Center" Margin="0,0,14,0"
                      DockPanel.Dock="Left" Checked="CanvasGrid_Changed" Unchecked="CanvasGrid_Changed"
                      ToolTip="Show 20 px guides and snap moved or resized items to them"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <TextBlock x:Name="CanvasZoomText" Text="100%" FontSize="10" Foreground="#5C6B7E"
                         VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Scroll over the canvas to zoom"/>
              <ComboBox x:Name="CanvasPreset" Width="170" FontSize="11" SelectedIndex="0" ToolTip="Canvas size presets" SelectionChanged="CanvasPreset_Changed"/>
              <TextBox x:Name="CanvasWidthInput" Width="58" FontSize="11" Margin="4,0,0,0" ToolTip="Canvas width in pixels"/>
              <TextBox x:Name="CanvasHeightInput" Width="58" FontSize="11" Margin="4,0,0,0" ToolTip="Canvas height in pixels"/>
              <Button Content="Resize" FontSize="11" Padding="8,4" Margin="4,0,0,0" Click="CanvasResize_Click" ToolTip="Scale the whole layout into this canvas size"/>
            </StackPanel>
            <TextBlock x:Name="CanvasInfo" Text="wheel zooms · arrow keys nudge · Shift+arrow moves 10 px" Foreground="#93A0B2" VerticalAlignment="Center" ToolTip="Select an item, then use the arrow keys to nudge it. Hold Shift for bigger steps."/>
          </DockPanel>
          <!-- The artwork backdrop: it shows in the studio, the previews and the audience output. -->
          <DockPanel Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <!-- The two named colors share one width: "Navy" is a shorter word, and letting the
                   text size the button made it read as a smaller control than "Black". -->
              <Button Content="Navy" FontSize="11" Padding="8,4" MinWidth="66" Height="30" VerticalAlignment="Center" Click="CanvasBackgroundNavy_Click"
                      ToolTip="Reset the artwork backdrop to ScorePlus navy"/>
              <Button Content="Black" FontSize="11" Padding="8,4" MinWidth="66" Height="30" VerticalAlignment="Center" Margin="4,0,0,0" Click="CanvasBackgroundBlack_Click"/>
              <Button Content="Choose…" FontSize="11" Padding="8,4" Margin="4,0,0,0" Click="CanvasBackground_Click"
                      ToolTip="Pick any color for the artwork backdrop"/>
              <Border x:Name="CanvasBackgroundSwatch" Width="26" Height="26" CornerRadius="4" Margin="6,0,0,0"
                      BorderBrush="#3A4552" BorderThickness="1" VerticalAlignment="Center"
                      local:ThemeManager.SkipTheme="True" ToolTip="The color behind this layout's artwork"/>
            </StackPanel>
            <TextBlock Text="CANVAS BACKGROUND" FontSize="10" FontWeight="Bold" Foreground="#5C6B7E"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="CanvasBackgroundInput" Width="110" FontSize="11" ToolTip="#AARRGGBB or #RRGGBB"
                     TextChanged="CanvasBackgroundInput_Changed"/>
            <TextBlock x:Name="CanvasBackgroundHintText" Text="Applies to this layout on every screen." FontSize="10" Foreground="#5C6B7E"
                       VerticalAlignment="Center" Margin="10,0,0,0"/>
          </DockPanel>
        </StackPanel>
        <Border Grid.Row="1" x:Name="CanvasFrame" Background="#171C25" ClipToBounds="True"
                MouseMove="Canvas_MouseMove" MouseLeftButtonUp="Canvas_MouseUp"
                SizeChanged="CanvasFrame_SizeChanged" PreviewMouseWheel="CanvasFrame_MouseWheel">
          <!-- The artwork keeps its real pixel size. A Viewbox fits it to the panel and the scroll
               wheel changes the Viewbox's size; the ScrollViewer gives the enlarged artwork
               somewhere to pan. The edge border shows exactly where the artwork ends. -->
          <ScrollViewer x:Name="CanvasScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="Transparent">
            <Border x:Name="ArtworkEdge" BorderBrush="#4A586A" BorderThickness="1" ClipToBounds="True"
                    SnapsToDevicePixels="True">
              <Viewbox x:Name="ArtworkViewbox" Stretch="Uniform">
                <Grid>
                  <Canvas x:Name="DesignCanvas" Width="1280" Height="720" Background="#091018" RenderTransformOrigin="0,0"/>
                  <!-- Guides sit above the artwork so an opaque backdrop cannot hide them, but they
                       never hit-test or become part of the exported layout. -->
                  <Canvas x:Name="GridCanvas" Width="1280" Height="720" IsHitTestVisible="False"
                          Visibility="Collapsed"/>
                  <!-- One frame around a multi-selection. Its corner handle scales the whole group;
                       individual elements keep their own handle only when selected alone. -->
                  <Canvas x:Name="SelectionCanvas" Width="1280" Height="720">
                    <Border x:Name="GroupSelectionBox" BorderBrush="#FF00BFFF" BorderThickness="2"
                            CornerRadius="2" IsHitTestVisible="False"
                            Visibility="Collapsed"/>
                    <Border x:Name="GroupResizeHandle" Width="18" Height="18" Background="#FF00BFFF"
                            BorderBrush="White" BorderThickness="1" Cursor="SizeNWSE" Focusable="False"
                            Visibility="Collapsed" ToolTip="Drag to resize the whole selection"/>
                  </Canvas>
                </Grid>
              </Viewbox>
            </Border>
          </ScrollViewer>
        </Border>
      </Grid>
    </Border>

    <!-- ============ PROPERTIES (only what applies to this kind of element) ============ -->
    <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="PropertyPanel" Background="#171C25">
        <TextBlock Text="ELEMENT PROPERTIES" FontWeight="Bold" Margin="12,12,12,2"/>

        <!-- A part copied from another layout stays linked: edits travel to every copy. -->
        <StackPanel x:Name="LinkSection">
          <TextBlock Text="LINKED PART" Style="{StaticResource SectionTitle}"/>
          <TextBlock x:Name="LinkHint" Text="" Foreground="#93A0B2" FontSize="10" TextWrapping="Wrap" Margin="10,0,10,6"/>
          <Button x:Name="BreakLinkButton" Content="Break link" Margin="10,0,10,8" Padding="10,5" FontSize="11"
                  Click="BreakLink_Click"
                  ToolTip="Leave this copy where it is: from now on it changes on its own"/>
        </StackPanel>

        <TextBlock Text="NAME" Style="{StaticResource SectionTitle}"/>
        <TextBox x:Name="NameInput" Style="{StaticResource FieldBox}" TextChanged="Property_Changed"/>

        <TextBlock Text="POSITION &amp; SIZE" Style="{StaticResource SectionTitle}"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="X" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="XInput" Style="{StaticResource FieldBox}" TextChanged="Property_Changed"/>
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Y" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="YInput" Style="{StaticResource FieldBox}" TextChanged="Property_Changed"/>
          </StackPanel>
          <StackPanel Grid.Row="1">
            <TextBlock Text="Width" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="WidthInput" Style="{StaticResource FieldBox}" TextChanged="Property_Changed"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="1">
            <TextBlock Text="Height" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="HeightInput" Style="{StaticResource FieldBox}" TextChanged="Property_Changed"/>
          </StackPanel>
        </Grid>
        <!-- Copy and paste of size and placement, so matching plates never have to be measured. -->
        <Grid Margin="0,3,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="CopySizeButton" Content="Copy size" Padding="6,3" FontSize="10" Margin="10,0,3,0"
                  Click="CopySize_Click" ToolTip="Remember this item's width and height (Ctrl+Shift+C)"/>
          <Button x:Name="PasteSizeButton" Grid.Column="1" Content="Paste size" Padding="6,3" FontSize="10" Margin="3,0,10,0"
                  Click="PasteSize_Click" ToolTip="Give every selected item the copied size (Ctrl+Shift+V)"/>
        </Grid>
        <Grid Margin="0,3,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="CopyPlacementButton" Content="Copy X Y rot" Padding="6,3" FontSize="10" Margin="10,0,3,0"
                  Click="CopyPlacement_Click" ToolTip="Remember this item's X, Y and rotation (Ctrl+Alt+C)"/>
          <Button x:Name="PastePlacementButton" Grid.Column="1" Content="Paste X Y rot" Padding="6,3" FontSize="10" Margin="3,0,10,0"
                  Click="PastePlacement_Click" ToolTip="Move every selected item to the copied X, Y and rotation (Ctrl+Alt+V)"/>
        </Grid>

        <StackPanel x:Name="TextSection">
          <TextBlock Text="TEXT" Style="{StaticResource SectionTitle}"/>
          <TextBox x:Name="ContentInput" Style="{StaticResource FieldBox}" TextChanged="Property_Changed"
                   AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" MaxHeight="180"
                   VerticalScrollBarVisibility="Auto" ToolTip="Text, a {{TOKEN}}, or the markup of an HTML element"/>
          <TextBlock Text="Text alignment" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="TextAlignInput" Margin="10,0,10,4" SelectionChanged="Property_Changed"
                    ToolTip="Where the value sits inside its box: hard left, centred, or hard right"/>
          <!-- Which player and stat this element prints, whatever is selected on the desk. -->
          <StackPanel x:Name="PlayerDataSection">
            <TextBlock Text="PLAYER DATA" Style="{StaticResource SectionTitle}"/>
            <TextBlock x:Name="PlayerDataHintText" Text="This element can follow the selected player, or pin one player from a roster so it never changes when somebody else goes on the graphic."
                       Foreground="#93A0B2" FontSize="10" TextWrapping="Wrap" Margin="10,0,10,4"/>
            <TextBlock Text="Team" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="PlayerSideInput" Margin="10,0,10,3" SelectionChanged="PlayerBinding_Changed"/>
            <TextBlock Text="Player" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="PlayerPickInput" Margin="10,0,10,3" SelectionChanged="PlayerBinding_Changed"/>
            <TextBlock Text="Value" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="PlayerFieldInput" Margin="10,0,10,4" SelectionChanged="PlayerBinding_Changed"/>
            <TextBlock x:Name="PlayerBindingHint" Foreground="#93A0B2" FontSize="10" TextWrapping="Wrap" Margin="10,0,10,6"/>
          </StackPanel>
          <StackPanel x:Name="PeriodSection">
            <TextBlock Text="Quarter style for this element" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="PeriodFormatInput" Margin="10,0,10,4" SelectionChanged="Property_Changed"
                      ToolTip="How {{PERIOD}} prints on this element — Quarter 1, Q1, 1 or 1st"/>
          </StackPanel>
        </StackPanel>

        <!-- The host box carries the angle, so rotation turns the whole item: plate, artwork and text. -->
        <StackPanel x:Name="TransformSection">
          <TextBlock Text="TRANSFORM" Style="{StaticResource SectionTitle}"/>
          <TextBlock Text="Rotation (degrees)" Style="{StaticResource FieldLabel}"/>
          <TextBox x:Name="RotationInput" Style="{StaticResource FieldBox}" TextChanged="Property_Changed"
                   ToolTip="Rotate this element clockwise, for example −8 for rising text"/>
        </StackPanel>

        <!-- A drop shadow is what keeps lettering readable over a photograph of a crowd. -->
        <StackPanel x:Name="ShadowSection">
          <TextBlock Text="TEXT SHADOW" Style="{StaticResource SectionTitle}"/>
          <CheckBox x:Name="TextShadowInput" Content="Shadow behind the letters" FontSize="11" Margin="10,0,10,4"
                    Click="Property_Changed" ToolTip="Lifts white lettering off a busy plate or a photo"/>
          <TextBlock Text="Shadow color" Style="{StaticResource FieldLabel}"/>
          <DockPanel Margin="0,0,10,2">
            <Button DockPanel.Dock="Right" Content="Pick" Padding="8,3" FontSize="10" Margin="4,0,0,0"
                    Click="TextShadowColor_Click" ToolTip="Choose a shadow colour"/>
            <TextBox x:Name="TextShadowColorInput" Style="{StaticResource FieldBox}" Margin="10,0,0,0" TextChanged="Property_Changed"/>
          </DockPanel>
          <Grid Margin="0,3,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Offset (px)" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="TextShadowOffsetInput" Style="{StaticResource FieldBox}" TextChanged="Property_Changed"
                       ToolTip="How far the shadow sits down and to the right"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Softness" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="TextShadowSoftnessInput" Style="{StaticResource FieldBox}" TextChanged="Property_Changed"
                       ToolTip="0 is a hard drop, 30 a soft glow"/>
            </StackPanel>
          </Grid>
          <TextBlock Text="Shadow angle (degrees)" Style="{StaticResource FieldLabel}"/>
          <TextBox x:Name="TextShadowAngleInput" Style="{StaticResource FieldBox}" TextChanged="Property_Changed"
                   ToolTip="Which way the shadow falls: 0 right, 90 straight down, 180 left, 270 up. 45 is down-right."/>
        </StackPanel>

        <StackPanel x:Name="FontSection">
          <TextBlock Text="TYPE" Style="{StaticResource SectionTitle}"/>
          <TextBlock Text="Font" Style="{StaticResource FieldLabel}"/>
          <DockPanel Margin="0,0,10,2">
            <Button DockPanel.Dock="Right" Content="Import font…" Margin="4,0,0,0" Padding="8,4" FontSize="11"
                    Click="ImportFont_Click" ToolTip="Copy a .ttf or .otf into ScorePlus and use it on the graphic"/>
            <ComboBox x:Name="FontInput" Margin="10,0,0,0" IsTextSearchEnabled="True" MaxDropDownHeight="320"
                      SelectionChanged="Property_Changed" ToolTip="Pick any installed font, or import your own"/>
          </DockPanel>
          <TextBlock Text="Font size" Style="{StaticResource FieldLabel}"/>
          <DockPanel Margin="10,0,10,4">
            <Button DockPanel.Dock="Right" Content="Paste" Margin="4,0,0,0" Padding="8,4" FontSize="11"
                    Click="PasteTextSize_Click" ToolTip="Give this element the copied text size"/>
            <Button DockPanel.Dock="Right" Content="Copy" Margin="4,0,0,0" Padding="8,4" FontSize="11"
                    Click="CopyTextSize_Click" ToolTip="Remember this element's text size"/>
            <TextBox x:Name="FontInputSize" Margin="0" TextChanged="Property_Changed"/>
          </DockPanel>
          <TextBlock Text="Text style" Style="{StaticResource FieldLabel}"/>
          <WrapPanel Margin="8,0,8,2">
            <CheckBox x:Name="BoldInput" Content="Bold" Margin="2,2,10,2" Checked="Property_Changed" Unchecked="Property_Changed"/>
            <CheckBox x:Name="ItalicInput" Content="Italic" Margin="2,2,10,2" Checked="Property_Changed" Unchecked="Property_Changed"/>
            <CheckBox x:Name="UnderlineInput" Content="Underline" Margin="2,2,10,2" Checked="Property_Changed" Unchecked="Property_Changed"/>
            <CheckBox x:Name="StrikeInput" Content="Strike" Margin="2,2,10,2" Checked="Property_Changed" Unchecked="Property_Changed"/>
          </WrapPanel>
          <TextBlock Text="Text color" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="ForegroundSourceInput" Margin="10,0,10,3" SelectionChanged="Property_Changed"
                    ToolTip="Use a fixed color or one of the team palette colors"/>
          <DockPanel Margin="0,0,10,4">
            <Button DockPanel.Dock="Right" Content="Choose…" Margin="4,0,0,0" Click="TextColor_Click" ToolTip="Open the color palette"/>
            <Border x:Name="TextColorSwatch" Width="24" Height="24" CornerRadius="4" Margin="10,0,6,0"
                    BorderBrush="#3A4552" BorderThickness="1" VerticalAlignment="Center"
                    local:ThemeManager.SkipTheme="True" ToolTip="The color this element actually draws"/>
            <TextBox x:Name="ColorInput" Margin="0" TextChanged="Property_Changed"/>
          </DockPanel>
        </StackPanel>

        <StackPanel x:Name="LogoSection">
          <TextBlock Text="TEAM LOGO" Style="{StaticResource SectionTitle}"/>
          <ComboBox x:Name="LogoInput" Margin="10,0,10,4" SelectionChanged="Property_Changed"
                    ToolTip="Team logos are imported in the control panel, beside the team name"/>
          <TextBlock x:Name="LogoHintText" Text="Logos are configured in the control panel: the … button beside each team name. This element just chooses which team it shows."
                     Foreground="#93A0B2" FontSize="10" TextWrapping="Wrap" Margin="10,0,10,6"/>
        </StackPanel>

        <StackPanel x:Name="PlayerPhotoSection">
          <TextBlock Text="PLAYER PHOTO" Style="{StaticResource SectionTitle}"/>
          <TextBlock Text="Follow the selected player on one side. Upload the portrait on the Rosters tab; switching the selected player changes the picture without a rebuild."
                     Foreground="#93A0B2" FontSize="10" TextWrapping="Wrap" Margin="10,0,10,4"/>
          <ComboBox x:Name="PlayerPhotoSideInput" Margin="10,0,10,6" SelectionChanged="Property_Changed"
                    ToolTip="Follow the selected home player, the selected visitors player, or use a fixed image instead"/>
        </StackPanel>

        <StackPanel x:Name="LayoutSection">
          <TextBlock Text="LIVE LAYOUT" Style="{StaticResource SectionTitle}"/>
          <TextBlock Text="Source layout" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="NestedLayoutInput" Margin="10,0,10,4" SelectionChanged="NestedLayout_Changed"
                    ToolTip="The layout this box shows live"/>
          <TextBlock x:Name="NestedLayoutHint" Text="Choose a layout. The feed follows its artwork and values and can be resized like any other element."
                     Foreground="#93A0B2" FontSize="10" TextWrapping="Wrap" Margin="10,0,10,6"/>
          <CheckBox x:Name="NestedAspectInput" Content="Keep the source layout's shape" Margin="10,2,10,4"
                    Checked="Property_Changed" Unchecked="Property_Changed"
                    ToolTip="On: letterbox the feed to the source's proportions. Off: stretch it to this box."/>
          <TextBlock Text="Tip: drag the corner handle to resize the feed. Open the source layout above to edit its artwork; this box follows automatically."
                     Foreground="#5C6B7E" FontSize="10" TextWrapping="Wrap" Margin="10,0,10,8"/>
        </StackPanel>

        <StackPanel x:Name="ShapePanel">
          <TextBlock Text="SHAPE" Style="{StaticResource SectionTitle}"/>
          <TextBlock Text="Shape type" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="ShapeInput" Margin="10,0,10,4" SelectionChanged="Property_Changed"/>
        </StackPanel>

        <StackPanel x:Name="IconSection">
          <TextBlock Text="ICON" Style="{StaticResource SectionTitle}"/>
          <TextBlock Text="Live artwork instead of (or beside) typed text" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="IconInput" Margin="10,0,10,4" SelectionChanged="Property_Changed"
                    ToolTip="Timeout bars, a dot on the side of the team with the ball, or an icon you made">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Converter={StaticResource IconNameConverter}}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <!-- Icons made in the Icon Creator: pick one, or open it to draw a new one. -->
          <StackPanel x:Name="IconCustomPanel">
            <TextBlock x:Name="IconCustomLabel" Text="Made icon" Style="{StaticResource FieldLabel}"/>
            <DockPanel Margin="0,0,10,8">
              <Button DockPanel.Dock="Right" Content="Icon creator…" Margin="4,0,0,0" Click="IconMaker_Click"
                      ToolTip="Open the Icon Creator to make an icon, or import or export a ScorePlus Icon (.spi) file"/>
              <ComboBox x:Name="IconCustomInput" Margin="10,0,0,0"
                        ToolTip="Which made icon this element draws"/>
            </DockPanel>
          </StackPanel>
          <!-- Which value the icon follows, and where it sits: a flag mark that appears when a
               flag is down, placed and coloured without touching the text it shares a box with. -->
          <StackPanel x:Name="IconValuePanel">
            <TextBlock Text="Follows a value (optional)" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="IconTokenInput" Style="{StaticResource FieldBox}" TextChanged="Property_Changed"
                     ToolTip="A token such as {{PENALTY_TYPE}}. The icon is on the graphic only while that value is set, and leaves when it clears."/>
            <TextBlock Text="Offset from the box, in pixels" Style="{StaticResource FieldLabel}"/>
            <DockPanel Margin="0,0,10,4">
              <TextBox x:Name="IconOffsetXInput" Width="64" Margin="10,0,0,0" TextChanged="Property_Changed"
                       ToolTip="Move the icon right (positive) or left (negative)"/>
              <TextBox x:Name="IconOffsetYInput" Width="64" Margin="6,0,0,0" TextChanged="Property_Changed"
                       ToolTip="Move the icon down (positive) or up (negative)"/>
            </DockPanel>
            <TextBlock Text="Icon colour" Style="{StaticResource FieldLabel}"/>
            <DockPanel Margin="0,0,10,8">
              <Button DockPanel.Dock="Right" Content="Choose…" Margin="4,0,0,0" Click="IconColor_Click"
                      ToolTip="Pick the icon's own colour"/>
              <Border x:Name="IconColorSwatch" Width="24" Height="24" CornerRadius="4" Margin="10,0,6,0"
                      BorderBrush="#3A4552" BorderThickness="1" VerticalAlignment="Center"
                      local:ThemeManager.SkipTheme="True" ToolTip="The colour this icon actually draws"/>
              <TextBox x:Name="IconColorInput" TextChanged="Property_Changed"
                       ToolTip="Leave empty to use the element's text colour"/>
            </DockPanel>
          </StackPanel>
          <CheckBox x:Name="IconVisitorsInput" Content="Count the visitors' timeouts" Margin="10,2,10,4"
                    Checked="Property_Changed" Unchecked="Property_Changed"/>
          <CheckBox x:Name="IconFlipInput" Content="Put the home side on the left" Margin="10,2,10,8"
                    Checked="Property_Changed" Unchecked="Property_Changed"/>
          <!-- Timeout bars have their own size, independent of the plate. -->
          <StackPanel x:Name="IconScalePanel">
            <TextBlock Text="Timeout bar size (0.25–3)" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="IconScaleInput" Style="{StaticResource FieldBox}" TextChanged="Property_Changed"
                     ToolTip="Make the timeout bars smaller or larger; 1 is the natural size"/>
            <CheckBox x:Name="IconVerticalInput" Content="Stack the timeout bars vertically" Margin="10,2,10,8"
                      Checked="Property_Changed" Unchecked="Property_Changed"
                      ToolTip="Keep each bar horizontal but stack them down the box instead of across it"/>
          </StackPanel>
          <!-- Baseball's bases: the inside can be its own color, separate from the outline. -->
          <StackPanel x:Name="BaseFillPanel">
            <TextBlock Text="Base fill" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="IconFillSourceInput" Margin="10,0,10,3" SelectionChanged="Property_Changed"
                      ToolTip="Fill a base with a fixed color or one of the team palette colors"/>
            <DockPanel Margin="0,0,10,8">
              <Button DockPanel.Dock="Right" Content="Choose…" Margin="4,0,0,0" Click="IconFillColor_Click"
                      ToolTip="Open the color palette for the base fill"/>
              <Border x:Name="IconFillSwatch" Width="24" Height="24" CornerRadius="4" Margin="10,0,6,0"
                      BorderBrush="#3A4552" BorderThickness="1" VerticalAlignment="Center"
                      local:ThemeManager.SkipTheme="True" ToolTip="What a lit base is filled with"/>
              <TextBox x:Name="IconFillInput" Margin="0" TextChanged="Property_Changed"
                       ToolTip="Leave empty to use the element's text color"/>
            </DockPanel>
          </StackPanel>
        </StackPanel>

        <StackPanel x:Name="VideoPanel">
          <TextBlock Text="VIDEO" Style="{StaticResource SectionTitle}"/>
          <TextBlock Text="Media tag" Style="{StaticResource FieldLabel}"/>
          <TextBox x:Name="MediaTagInput" Style="{StaticResource FieldBox}" TextChanged="Property_Changed"
                   ToolTip="Leave empty to show any playing clip, or name a tag so only that tag's clips appear"/>
          <TextBlock x:Name="VideoTagHintText" Text="Only media with this tag plays inside this element. The tag label is drawn in the studio only; the audience screen stays blank until a clip is cued."
                     Foreground="#93A0B2" FontSize="10" TextWrapping="Wrap" Margin="10,0,10,6"/>
          <CheckBox x:Name="PreserveAspectInput" Content="Preserve the video's aspect ratio" Margin="10,2,10,2"
                    Checked="Property_Changed" Unchecked="Property_Changed"
                    ToolTip="On: the box is locked to the picture's shape, so nothing is stretched or cropped. Off: the box is free and the clip fills it."/>
          <TextBlock Text="Aspect (width ÷ height)" Style="{StaticResource FieldLabel}"/>
          <TextBox x:Name="AspectInput" Style="{StaticResource FieldBox}" TextChanged="Property_Changed"
                   ToolTip="16:9 is 1.7778 · 4:3 is 1.3333 · vertical 9:16 is 0.5625"/>
          <TextBlock Text="Chroma key color" Style="{StaticResource FieldLabel}"/>
          <DockPanel Margin="0,0,10,2">
            <Button DockPanel.Dock="Right" Content="Choose…" Margin="4,0,0,0" Click="ChromaKeyColor_Click"
                    ToolTip="Pick the green or blue backdrop color to make transparent"/>
            <Border x:Name="ChromaKeySwatch" Width="24" Height="24" CornerRadius="4" Margin="10,0,6,0"
                    BorderBrush="#3A4552" BorderThickness="1" VerticalAlignment="Center"
                    local:ThemeManager.SkipTheme="True" ToolTip="Pixels of this color become transparent in this video box"/>
            <TextBox x:Name="ChromaKeyInput" Margin="0" TextChanged="Property_Changed"
                     ToolTip="Leave empty to turn chroma key off"/>
          </DockPanel>
          <TextBlock Text="Key tolerance (0–1)" Style="{StaticResource FieldLabel}"/>
          <TextBox x:Name="ChromaKeyToleranceInput" Style="{StaticResource FieldBox}" TextChanged="Property_Changed"
                   ToolTip="0 keys only the exact color; 0.15–0.25 tolerates uneven lighting and compression"/>
          <TextBlock x:Name="ChromaKeyHintText" Text="Tolerance is how different a pixel can be from the key color and still disappear: 0 keys only the exact color. Raise it if green edges remain; lower it if the subject starts disappearing."
                     Foreground="#93A0B2" FontSize="10" TextWrapping="Wrap" Margin="10,0,10,6"/>
          <TextBlock Text="Audio output for this element" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="AudioDeviceInput" Margin="10,0,10,4" SelectionChanged="Property_Changed"
                    ToolTip="Each video element can play through its own speaker, so two clips never share one output"/>
          <TextBlock x:Name="AudioHintText" Text="This element's own clip plays its sound on this output. Default uses the Windows output."
                     Foreground="#93A0B2" FontSize="10" TextWrapping="Wrap" Margin="10,0,10,6"/>
        </StackPanel>

        <StackPanel x:Name="BackgroundSection">
          <TextBlock Text="BACKGROUND" Style="{StaticResource SectionTitle}"/>
          <ComboBox x:Name="BackgroundSourceInput" Margin="10,0,10,3" SelectionChanged="Property_Changed"
                    ToolTip="Use a fixed color or one of the team palette colors"/>
          <TextBlock Text="Background color" Style="{StaticResource FieldLabel}"/>
          <DockPanel Margin="0,0,10,4">
            <Button DockPanel.Dock="Right" Content="Choose…" Margin="4,0,0,0" Click="BackgroundColor_Click" ToolTip="Open the color palette"/>
            <Border x:Name="BackgroundColorSwatch" Width="24" Height="24" CornerRadius="4" Margin="10,0,6,0"
                    BorderBrush="#3A4552" BorderThickness="1" VerticalAlignment="Center"
                    local:ThemeManager.SkipTheme="True" ToolTip="The color painted behind this element"/>
            <TextBox x:Name="BackgroundInput" Margin="0" TextChanged="Property_Changed"/>
          </DockPanel>
          <CheckBox x:Name="GradientInput" Content="Gradient background" Margin="10,2,10,2"
                    Checked="Property_Changed" Unchecked="Property_Changed"
                    ToolTip="Blend the background from the color above into a second color"/>
          <TextBlock Text="Second color" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="GradientSourceInput" Margin="10,0,10,3" SelectionChanged="Property_Changed"
                    ToolTip="Use a fixed color or one of the team palette colors"/>
          <DockPanel Margin="0,0,10,4">
            <Button DockPanel.Dock="Right" Content="Choose…" Margin="4,0,0,0" Click="GradientColor2_Click" ToolTip="Open the color palette"/>
            <Border x:Name="GradientColorSwatch" Width="24" Height="24" CornerRadius="4" Margin="10,0,6,0"
                    BorderBrush="#3A4552" BorderThickness="1" VerticalAlignment="Center"
                    local:ThemeManager.SkipTheme="True" ToolTip="The second color this element's gradient ends on"/>
            <TextBox x:Name="GradientColorInput" Margin="0" TextChanged="Property_Changed"/>
          </DockPanel>
          <TextBlock Text="Gradient angle (degrees)" Style="{StaticResource FieldLabel}"/>
          <TextBox x:Name="GradientAngleInput" Style="{StaticResource FieldBox}" TextChanged="Property_Changed"
                   ToolTip="0 runs left to right, 90 top to bottom"/>
          <CheckBox x:Name="TransparentBackgroundInput" Content="No background box (transparent)" Margin="10,4,10,2"
                    Checked="Property_Changed" Unchecked="Property_Changed"/>
          <Button Content="Make opaque full-canvas backdrop" Margin="10,2,10,8" Padding="10,5" FontSize="11"
                  Click="OpaqueBackdrop_Click"
                  ToolTip="Fill the whole canvas, remove transparency, and send this element behind every other item"/>
        </StackPanel>

        <!-- An outline is drawn by the element's host, so it works on text, logos, shapes and video. -->
        <StackPanel x:Name="BorderSection">
          <TextBlock Text="BORDER" Style="{StaticResource SectionTitle}"/>
          <TextBlock Text="Border width (0 = none)" Style="{StaticResource FieldLabel}"/>
          <TextBox x:Name="BorderWidthInput" Style="{StaticResource FieldBox}" TextChanged="Property_Changed"
                   ToolTip="Outline thickness in design pixels"/>
          <TextBlock Text="Border color" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="BorderSourceInput" Margin="10,0,10,3" SelectionChanged="Property_Changed"
                    ToolTip="Use a fixed color or one of the team palette colors"/>
          <DockPanel Margin="0,0,10,4">
            <Button DockPanel.Dock="Right" Content="Choose…" Margin="4,0,0,0" Click="BorderColor_Click" ToolTip="Open the color palette"/>
            <Border x:Name="BorderColorSwatch" Width="24" Height="24" CornerRadius="4" Margin="10,0,6,0"
                    BorderBrush="#3A4552" BorderThickness="1" VerticalAlignment="Center"
                    local:ThemeManager.SkipTheme="True" ToolTip="The color this element's outline draws"/>
            <TextBox x:Name="BorderColorInput" Margin="0" TextChanged="Property_Changed"/>
          </DockPanel>
        </StackPanel>

        <TextBlock Text="ANIMATION" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="Element animation" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="AnimationInput" Margin="10,0,10,4" SelectionChanged="Property_Changed"
                  ToolTip="Choose a built-in motion preset or any animation saved in the show library"/>
        <Button Content="Animation maker…" Margin="10,0,10,8" Padding="10,5" FontSize="11" Click="MotionMakerAnimation_Click"
                ToolTip="Key motion this element follows while it is up, or when its value changes"/>

        <TextBlock Text="BEHAVIOUR" Style="{StaticResource SectionTitle}"/>
        <!-- Only printed values change; a logo, shape or video has nothing to cross to. -->
        <StackPanel x:Name="TransitionSection">
          <TextBlock Text="Value change" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="TransitionInput" Margin="10,0,10,4" SelectionChanged="Property_Changed"
                    ToolTip="How this value crosses to a new number or name"/>
          <TextBlock Text="Transition time (0–5 seconds)" Style="{StaticResource FieldLabel}"/>
          <TextBox x:Name="TransitionSpeedInput" Style="{StaticResource FieldBox}" TextChanged="Property_Changed"
                   ToolTip="0 is an instant swap, 5 a very slow dissolve. The value leaves slightly faster than it arrives."/>
          <CheckBox x:Name="DownTransitionInput" Content="Different animation when the value goes down"
                    Margin="10,6,10,2" Checked="Property_Changed" Unchecked="Property_Changed"
                    ToolTip="Use a separate crossing when a number falls instead of rising"/>
          <TextBlock Text="Value change (down)" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="TransitionDownInput" Margin="10,0,10,4" SelectionChanged="Property_Changed"
                    ToolTip="How this value crosses to a lower number"/>
          <TextBlock Text="Down transition time (0–5 seconds)" Style="{StaticResource FieldLabel}"/>
          <TextBox x:Name="TransitionDownSpeedInput" Style="{StaticResource FieldBox}" TextChanged="Property_Changed"
                   ToolTip="0 is an instant swap, 5 a very slow dissolve. Blank follows the up time."/>
        </StackPanel>
        <!-- The value keeps the hidden box the property writer already understands; the slider is
             what the operator actually sees, and each layer has its own. -->
        <TextBox x:Name="OpacityInput" Visibility="Collapsed" Text="1"/>
        <TextBlock Text="Element opacity" Style="{StaticResource FieldLabel}"/>
        <DockPanel Margin="10,0,10,2">
          <TextBlock x:Name="OpacityReadout" DockPanel.Dock="Right" Text="100%" Foreground="#93A0B2" FontSize="10"
                     VerticalAlignment="Center" Width="40" TextAlignment="Right"/>
          <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Value="100" MinHeight="24"
                  ValueChanged="Opacity_Changed" ToolTip="How solid the whole element is — plate, outline and text together"/>
        </DockPanel>
        <TextBlock Text="Text opacity" Style="{StaticResource FieldLabel}"/>
        <DockPanel Margin="10,0,10,2">
          <TextBlock x:Name="TextOpacityReadout" DockPanel.Dock="Right" Text="100%" Foreground="#93A0B2" FontSize="10"
                     VerticalAlignment="Center" Width="40" TextAlignment="Right"/>
          <Slider x:Name="TextOpacitySlider" Minimum="0" Maximum="100" Value="100" MinHeight="24"
                  ValueChanged="Opacity_Changed" ToolTip="Fade just the printed value, leaving the plate and outline solid"/>
        </DockPanel>
        <TextBlock Text="Background opacity" Style="{StaticResource FieldLabel}"/>
        <DockPanel Margin="10,0,10,2">
          <TextBlock x:Name="BackgroundOpacityReadout" DockPanel.Dock="Right" Text="100%" Foreground="#93A0B2" FontSize="10"
                     VerticalAlignment="Center" Width="40" TextAlignment="Right"/>
          <Slider x:Name="BackgroundOpacitySlider" Minimum="0" Maximum="100" Value="100" MinHeight="24"
                  ValueChanged="Opacity_Changed" ToolTip="Fade just the background plate"/>
        </DockPanel>
        <TextBlock Text="Border opacity" Style="{StaticResource FieldLabel}"/>
        <DockPanel Margin="10,0,10,4">
          <TextBlock x:Name="BorderOpacityReadout" DockPanel.Dock="Right" Text="100%" Foreground="#93A0B2" FontSize="10"
                     VerticalAlignment="Center" Width="40" TextAlignment="Right"/>
          <Slider x:Name="BorderOpacitySlider" Minimum="0" Maximum="100" Value="100" MinHeight="24"
                  ValueChanged="Opacity_Changed" ToolTip="Fade just the outline"/>
        </DockPanel>
        <Button Content="Paint &amp; texture…" Margin="10,0,10,4" Padding="10,5" FontSize="11" Click="PaintTexture_Click"
                ToolTip="Gradients with any number of stops on the text and plate, plus metal, glass, grain and the other finishes"/>
        <Button Content="Transition builder…" Margin="10,0,10,3" Padding="10,5" FontSize="11" Click="MotionMakerTransition_Click"
                ToolTip="Key how this element's value leaves and arrives"/>
        <CheckBox x:Name="VisibleInput" Content="Visible on output" Margin="10,4,10,8" Checked="Property_Changed" Unchecked="Property_Changed"/>

        <TextBlock x:Name="CanvasFitTipText" Text="Scroll over the canvas to zoom in and out; the framed edge is the artwork. The optional grid snaps moved and resized items to 20 px."
                   Foreground="#93A0B2" FontSize="10" TextWrapping="Wrap" Margin="10,10,10,2"/>
        <TextBlock x:Name="ResizeTipText" Text="Resize: select one element and drag its corner, or select several to get one blue group box and drag its corner. The group scales as a whole. Hold Ctrl to scale the text with the box, Shift to keep its shape."
                   Foreground="#93A0B2" FontSize="10" TextWrapping="Wrap" Margin="10,4,10,12"/>
      </StackPanel>
    </ScrollViewer>

    <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" Content="Done" Padding="16,8" Click="Done_Click" ToolTip="Close the studio (Enter only commits the value you are editing)"/>
      <TextBlock x:Name="AllValuesHintText" Text="Every value can go on the graphic: team names and abbreviations, scores, period, game clock, play clock, timeout clock, timeouts left, possession, down, to go, down &amp; distance, ball on, sport, yards, turnovers, fouls, shot clock, baseball count and outs, hits, cards, shots, corners, date, time, and custom values such as {{STAT:Turnovers}}. Use Add sport data for the full list. Player values such as {{PLAYER:HOME:Yards}} come from whoever is on the graphic — switch the selected player in the Rosters tab and every one of them follows."
                 Foreground="#93A0B2" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
    </DockPanel>
  </Grid>
</Window>
