<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ScorePlus</AssemblyName>
    <RootNamespace>Scoreboard.Desktop</RootNamespace>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Product>ScorePlus</Product>
    <AssemblyTitle>ScorePlus</AssemblyTitle>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Description>ScorePlus live production scoreboard</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- WPF loads a few of its own assemblies by name at run time: the drag-and-drop helper, the
         popup accessibility bridge. Inside a single-file bundle they are not on disk under those
         names, so DoDragDrop and every drop-down threw "assembly not found" and the program died
         on the next layout pass. Extracting the whole bundle gives them the files they look for. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <!-- Only the program itself lands in the release folder: no NuGet XML docs beside it. -->
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Scoreboard.Core/Scoreboard.Core.csproj" /></ItemGroup>
  <ItemGroup>
    <!-- The brand mark and the taskbar icon. The transparent mark is the one used inside the app. -->
    <Resource Include="app.ico" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\horn-air.mp3" />
    <Resource Include="Assets\horn-buzzer.mp3" />
    <Resource Include="Assets\horn-siren.mp3" />
    <!-- Compiled PS 2.0 shader: makes the selected chroma-key colour transparent. -->
    <Resource Include="Assets\ChromaKey.ps" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageReference Include="System.IO.Ports" Version="10.0.14" />
  </ItemGroup>
</Project>
